---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import NotificationsPanel from "../components/notifications/NotificationsPanel";

const auth = Astro.locals.auth!;
---

<BaseLayout title="Notificaciones" description="Avisos de reportes, paradas y asignaciones" profile={auth.profile}>
  <main class="mx-auto w-full max-w-7xl space-y-6 px-4 py-4 sm:px-6 sm:py-6">
    <PageHeader title="Notificaciones" description="Novedades relacionadas con tu trabajo y tus reportes." />
    <NotificationsPanel client:load />
  </main>
</BaseLayout>
