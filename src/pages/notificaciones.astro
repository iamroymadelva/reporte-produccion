---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import NotificationsPanel from "../components/notifications/NotificationsPanel";

const auth = Astro.locals.auth!;
---

<BaseLayout title="Notificaciones" description="Avisos de reportes, paradas y asignaciones" profile={auth.profile}>
  <main class="mx-auto max-w-4xl space-y-5 px-4 py-6 sm:px-6 lg:py-8">
    <PageHeader eyebrow="Actividad" title="Notificaciones" description="Novedades relacionadas con tu trabajo y tus reportes." />
    <NotificationsPanel client:load />
  </main>
</BaseLayout>
