---
import BaseLayout from "../layouts/BaseLayout.astro";
import NotificationCenter from "../components/NotificationCenter";

const auth = Astro.locals.auth!;
---

<BaseLayout title="Notificaciones" description="Avisos de reportes, paradas y asignaciones" profile={auth.profile}>
  <main class="mx-auto max-w-4xl space-y-5 px-4 py-6 sm:px-6 lg:py-8">
    <header><p class="eyebrow">Actividad</p><h1 class="page-title">Notificaciones</h1><p class="mt-2 text-slate-600">Novedades relacionadas con tu trabajo y tus reportes.</p></header>
    <NotificationCenter mode="page" client:load />
  </main>
</BaseLayout>
