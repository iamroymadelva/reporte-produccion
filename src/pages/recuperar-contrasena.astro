---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { ArrowLeft, Factory } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardFooter, CardHeader } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { FieldLabel, Label } from "@/components/ui/label";

if (Astro.locals.auth) return Astro.redirect("/dashboard");
const error = Astro.url.searchParams.get("error");
const ok = Astro.url.searchParams.get("ok");
---

<BaseLayout title="Recuperar contraseña" description="Recuperación segura de contraseña">
  <main class="flex min-h-screen flex-col items-center justify-center gap-4 bg-gradient-to-br from-auth-from via-auth-via to-auth-to p-4">
    <Card className="w-full max-w-md shadow-2xl">
      <CardHeader className="space-y-1">
        <div class="mb-4 flex items-center justify-center">
          <div class="rounded-2xl bg-primary p-4 shadow-lg"><Factory className="h-12 w-12 text-primary-foreground" aria-hidden="true" /></div>
        </div>
        <h1 data-slot="card-title" class="text-center text-2xl leading-none font-bold">Recuperar contraseña</h1>
        <CardDescription className="text-center">Ingresa tu correo para recibir un enlace de recuperación.</CardDescription>
      </CardHeader>
      <form method="POST" action="/api/auth/recovery">
        <CardContent className="space-y-4">
          {error && <Alert variant="destructive"><AlertDescription>{error}</AlertDescription></Alert>}
          {ok && <Alert variant="success"><AlertDescription>{ok}</AlertDescription></Alert>}
          <Label>
            <FieldLabel>Correo electrónico</FieldLabel>
            <Input type="email" name="email" autoComplete="email" placeholder="nombre@empresa.com" required />
          </Label>
        </CardContent>
        <CardFooter className="mt-4 flex flex-col space-y-4">
          <Button type="submit" size="lg" className="w-full">Enviar instrucciones</Button>
          <a class="inline-flex min-h-11 items-center text-sm text-primary hover:underline" href="/iniciar-sesion"><ArrowLeft className="mr-1 h-4 w-4" aria-hidden="true" />Volver al inicio de sesión</a>
        </CardFooter>
      </form>
    </Card>
  </main>
</BaseLayout>
