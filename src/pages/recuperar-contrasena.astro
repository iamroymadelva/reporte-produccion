---
import BaseLayout from "../layouts/BaseLayout.astro";

if (Astro.locals.auth) return Astro.redirect("/dashboard");
const error = Astro.url.searchParams.get("error");
const ok = Astro.url.searchParams.get("ok");
---

<BaseLayout title="Recuperar contraseña" description="Recuperación segura de contraseña">
  <main class="grid min-h-screen place-items-center px-5 py-12">
    <section class="panel w-full max-w-md p-7 sm:p-9">
      <p class="eyebrow">Acceso seguro</p>
      <h1 class="page-title mt-2">Recuperar contraseña</h1>
      <p class="mt-3 text-slate-600">Ingresa tu correo para recibir un enlace de recuperación.</p>
      {error && <p class="mt-5 rounded-xl bg-red-50 p-4 text-sm font-medium text-red-800">{error}</p>}
      {ok && <p class="mt-5 rounded-xl bg-emerald-50 p-4 text-sm font-medium text-emerald-800">{ok}</p>}
      <form class="mt-7 space-y-5" method="POST" action="/api/auth/recovery">
        <label>
          <span class="field-label">Correo electrónico</span>
          <input class="field-control" type="email" name="email" autocomplete="email" required />
        </label>
        <button class="button-primary w-full" type="submit">Enviar instrucciones</button>
      </form>
      <a class="link mt-5 block text-center text-sm" href="/iniciar-sesion">Volver al inicio de sesión</a>
    </section>
  </main>
</BaseLayout>
