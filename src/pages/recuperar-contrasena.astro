---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { FieldLabel, Label } from "@/components/ui/label";

if (Astro.locals.auth) return Astro.redirect("/dashboard");
const error = Astro.url.searchParams.get("error");
const ok = Astro.url.searchParams.get("ok");
---

<BaseLayout title="Recuperar contraseña" description="Recuperación segura de contraseña">
  <main class="grid min-h-screen place-items-center px-5 py-12">
    <Card className="w-full max-w-md gap-0 p-7 sm:p-9">
      <PageHeader eyebrow="Acceso seguro" title="Recuperar contraseña" description="Ingresa tu correo para recibir un enlace de recuperación." />
      {error && <Alert variant="destructive" className="mt-5"><AlertDescription>{error}</AlertDescription></Alert>}
      {ok && <Alert variant="success" className="mt-5"><AlertDescription>{ok}</AlertDescription></Alert>}
      <form class="mt-7 space-y-5" method="POST" action="/api/auth/recovery">
        <Label>
          <FieldLabel>Correo electrónico</FieldLabel>
          <Input type="email" name="email" autoComplete="email" required />
        </Label>
        <button class={buttonVariants({ size: "lg", className: "w-full" })} type="submit">Enviar instrucciones</button>
      </form>
      <a class="mt-5 block text-center text-sm font-semibold text-primary underline-offset-4 hover:underline" href="/iniciar-sesion">Volver al inicio de sesión</a>
    </Card>
  </main>
</BaseLayout>
