---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDateTime, getBogotaDateKey } from "../lib/format";
import { createSupabaseServerClient } from "../lib/supabase/server";
import { statusLabels, type ReportStatus } from "../lib/types";

const auth = Astro.locals.auth!;
const isOperator = auth.profile.role === "OPERATOR";
const isViewer = auth.profile.role === "VIEWER";
const kpiLabels = isOperator
  ? {
      DRAFT: "Mis reportes en curso",
      SUBMITTED: "Mis reportes enviados",
      CANCELLED: "Mis reportes cancelados",
      ACTIVE_STOP: "Mis reportes en parada",
    }
  : {
      DRAFT: "Reportes en curso",
      SUBMITTED: "Reportes enviados",
      CANCELLED: "Reportes cancelados",
      ACTIVE_STOP: "Reportes en parada",
    };

const today = getBogotaDateKey();
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const reportsResult = await supabase
  .from("production_reports")
  .select("id, folio, report_date, production_order, status, creator_full_name, created_at, machine:machines(id, code, name), report_stop_events(id, ended_at)")
  .eq("report_date", today)
  .order("created_at", { ascending: false });

const reports = (reportsResult.data ?? []) as any[];
const recentReports = reports.slice(0, 10);
const reportCounts = reportsResult.error
  ? null
  : {
      DRAFT: reports.filter((report) => report.status === "DRAFT").length,
      SUBMITTED: reports.filter((report) => report.status === "SUBMITTED").length,
      CANCELLED: reports.filter((report) => report.status === "CANCELLED").length,
      ACTIVE_STOP: reports.filter((report) =>
        report.report_stop_events?.some((stop: any) => !stop.ended_at)
      ).length,
    };
const hasError = Boolean(reportsResult.error);
---

<BaseLayout title="Dashboard" description="Resumen operativo de producción" profile={auth.profile}>
  <main class="mx-auto max-w-7xl space-y-6 px-4 py-6 sm:px-6 lg:py-8">
    <header>
      <p class="eyebrow">Resumen de hoy</p>
      <h1 class="page-title">Dashboard</h1>
      <p class="mt-2 text-slate-600">Estado operativo de los reportes de producción del día.</p>
    </header>

    {hasError && (
      <p class="rounded-xl bg-red-50 p-4 font-medium text-red-800">
        No fue posible cargar todos los datos del dashboard. Intenta nuevamente.
      </p>
    )}

    <section class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4" aria-label="Indicadores de hoy">
      {!isViewer && (
        <article class="panel kpi-card p-4 sm:p-5 kpi-card-draft">
          <a class="kpi-link" href="/reportes?status=DRAFT" title="Ver reportes en curso">
            <span>{kpiLabels.DRAFT}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <p class="data-mono mt-3 text-3xl font-semibold text-slate-900">{reportCounts?.DRAFT ?? "—"}</p>
        </article>
      )}
      <article class="panel kpi-card p-4 sm:p-5 kpi-card-submitted">
        <a class="kpi-link" href="/reportes?status=SUBMITTED" title="Ver reportes enviados">
          <span>{isViewer ? "Reportes enviados hoy" : kpiLabels.SUBMITTED}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <p class="data-mono mt-3 text-3xl font-semibold text-slate-900">{reportCounts?.SUBMITTED ?? "—"}</p>
      </article>
      {!isViewer && (
        <article class="panel kpi-card p-4 sm:p-5 kpi-card-cancelled">
          <a class="kpi-link" href="/reportes?status=CANCELLED" title="Ver reportes cancelados">
            <span>{kpiLabels.CANCELLED}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <p class="data-mono mt-3 text-3xl font-semibold text-slate-900">{reportCounts?.CANCELLED ?? "—"}</p>
        </article>
      )}
      {!isViewer && (
        <article class="panel kpi-card p-4 sm:p-5 kpi-card-stop">
          <a class="kpi-link" href="/reportes?stop=active" title="Ver reportes en parada">
            <span>{kpiLabels.ACTIVE_STOP}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <p class="data-mono mt-3 text-3xl font-semibold text-slate-900">{reportCounts?.ACTIVE_STOP ?? "—"}</p>
        </article>
      )}
    </section>

    <section class="panel overflow-hidden p-0">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b p-5">
        <div>
          <h2 class="text-xl font-bold">{isOperator ? "Mis reportes recientes" : "Reportes recientes"}</h2>
          <p class="mt-1 text-sm text-slate-500">Últimos reportes con fecha operativa de hoy.</p>
        </div>
        <a class="link" href="/reportes">Ver todos</a>
      </div>

      {reportsResult.error ? (
        <p class="p-8 text-center text-slate-500">No fue posible cargar los reportes recientes.</p>
      ) : recentReports.length === 0 ? (
        <p class="p-8 text-center text-slate-500">No hay reportes de producción para hoy.</p>
      ) : (
        <>
        <div class="mobile-card-list md:hidden">
          {recentReports.map((report) => {
            const hasOpenStop = report.report_stop_events?.some((stop: any) => !stop.ended_at);
            return (
              <article class="mobile-data-card">
                <div class="flex items-start justify-between gap-3">
                  <a class="link data-mono min-w-0 break-words" href={`/reportes/${report.id}`}>{report.folio}</a>
                  <span class={`shrink-0 rounded-full px-3 py-1 text-xs font-semibold ${report.status === "DRAFT" ? "bg-amber-100 text-amber-800" : report.status === "CANCELLED" ? "bg-red-100 text-red-800" : "bg-emerald-100 text-emerald-800"}`}>
                    {statusLabels[report.status as ReportStatus]}
                  </span>
                </div>
                <dl class="grid gap-2 text-sm">
                  <div><dt class="text-slate-500">Fecha / hora</dt><dd>{formatDateTime(report.created_at)}</dd></div>
                  <div><dt class="text-slate-500">Máquina</dt><dd class="font-semibold">{report.machine ? `${report.machine.code} · ${report.machine.name}` : "—"}</dd></div>
                  <div><dt class="text-slate-500">Operario</dt><dd>{report.creator_full_name || "—"}</dd></div>
                </dl>
                {hasOpenStop && <p class="font-bold text-orange-700">● Parada activa</p>}
              </article>
            );
          })}
        </div>
        <div class="hidden overflow-x-auto md:block" role="region" aria-label="Reportes recientes" tabindex="0">
          <table class="w-full min-w-[640px] text-left text-sm md:min-w-[900px]">
            <thead class="bg-slate-50 text-slate-600">
              <tr>
                <th class="p-4">Folio</th>
                <th class="p-4">Fecha / hora</th>
                <th class="p-4">Máquina</th>
                <th class="hidden p-4 md:table-cell">O.P.</th>
                <th class="hidden p-4 md:table-cell">Operario</th>
                <th class="p-4">Estado</th>
                <th class="p-4">Parada</th>
              </tr>
            </thead>
            <tbody>
              {recentReports.map((report) => {
                const hasOpenStop = report.report_stop_events?.some((stop: any) => !stop.ended_at);
                return (
                  <tr class="border-t">
                    <td class="p-4">
                      <a class="link data-mono" href={`/reportes/${report.id}`}>{report.folio}</a>
                    </td>
                    <td class="p-4 text-slate-600">{formatDateTime(report.created_at)}</td>
                    <td class="p-4 font-semibold">{report.machine ? `${report.machine.code} · ${report.machine.name}` : "—"}</td>
                    <td class="hidden p-4 md:table-cell">{report.production_order || "—"}</td>
                    <td class="hidden p-4 md:table-cell">{report.creator_full_name || "—"}</td>
                    <td class="p-4">
                      <span class={`rounded-full px-3 py-1 font-semibold ${report.status === "DRAFT" ? "bg-amber-100 text-amber-800" : report.status === "CANCELLED" ? "bg-red-100 text-red-800" : "bg-emerald-100 text-emerald-800"}`}>
                        {statusLabels[report.status as ReportStatus]}
                      </span>
                    </td>
                    <td class="p-4">
                      {hasOpenStop ? <span class="rounded-full bg-orange-100 px-3 py-1 font-semibold text-orange-800">Activa</span> : "—"}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        </>
      )}
    </section>
  </main>
</BaseLayout>

<style>
  .kpi-card {
    position: relative;
    border-left-width: 4px;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .kpi-card:hover {
    box-shadow: 0 4px 12px rgb(15 23 42 / 0.08);
  }

  .kpi-card-draft { border-left-color: var(--color-amber-500); }
  .kpi-card-submitted { border-left-color: var(--color-emerald-600); }
  .kpi-card-cancelled { border-left-color: var(--color-red-600); }
  .kpi-card-stop { border-left-color: var(--color-orange-600); }

  .kpi-link {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--color-slate-600);
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Toda la tarjeta es clicable */
  .kpi-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .kpi-link:hover { color: var(--color-brand-800); }

  .kpi-link svg {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
    color: var(--color-slate-400);
    transition: color 150ms ease, transform 150ms ease;
  }

  .kpi-card:hover .kpi-link svg {
    color: var(--color-brand-700);
    transform: translateX(2px);
  }
</style>
