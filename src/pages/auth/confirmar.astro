---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Factory } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardFooter, CardHeader } from "@/components/ui/card";
import { createSupabaseServerClient } from "../../lib/supabase/server";

const tokenHash = Astro.url.searchParams.get("token_hash");
const requestedType = Astro.url.searchParams.get("type");
const type = requestedType === "invite" || requestedType === "recovery" ? requestedType : null;
let message = "El enlace no es válido, está incompleto o ya expiró.";

if (tokenHash && type) {
  const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
  const { error } = await supabase.auth.verifyOtp({ token_hash: tokenHash, type });
  if (!error) return Astro.redirect("/configurar-contrasena");
  message = "No fue posible verificar el enlace. Solicita uno nuevo e inténtalo nuevamente.";
}
---

<BaseLayout title="Confirmar acceso" description="Confirmación de acceso seguro">
  <main class="flex min-h-screen flex-col items-center justify-center gap-4 bg-gradient-to-br from-auth-from via-auth-via to-auth-to p-4">
    <Card className="w-full max-w-md shadow-2xl">
      <CardHeader className="space-y-1">
        <div class="mb-4 flex items-center justify-center">
          <div class="rounded-2xl bg-primary p-4 shadow-lg"><Factory className="h-12 w-12 text-primary-foreground" aria-hidden="true" /></div>
        </div>
        <h1 data-slot="card-title" class="text-center text-2xl leading-none font-bold">No fue posible confirmar el acceso</h1>
        <CardDescription className="text-center">Reporte de Producción</CardDescription>
      </CardHeader>
      <CardContent className="space-y-4">
        <Alert variant="destructive"><AlertDescription>{message}</AlertDescription></Alert>
      </CardContent>
      <CardFooter className="mt-4 flex flex-col space-y-4">
        <Button asChild size="lg" className="w-full"><a href="/iniciar-sesion">Volver al inicio de sesión</a></Button>
      </CardFooter>
    </Card>
  </main>
</BaseLayout>
