---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { createSupabaseServerClient } from "../../lib/supabase/server";

const tokenHash = Astro.url.searchParams.get("token_hash");
const requestedType = Astro.url.searchParams.get("type");
const type = requestedType === "invite" || requestedType === "recovery" ? requestedType : null;
let message = "El enlace no es válido, está incompleto o ya expiró.";

if (tokenHash && type) {
  const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
  const { error } = await supabase.auth.verifyOtp({ token_hash: tokenHash, type });
  if (!error) return Astro.redirect("/configurar-contrasena");
  message = "No fue posible verificar el enlace. Solicita uno nuevo e inténtalo nuevamente.";
}
---

<BaseLayout title="Confirmar acceso" description="Confirmación de acceso seguro">
  <main class="grid min-h-screen place-items-center px-5">
    <Card className="w-full max-w-lg gap-0 p-7 sm:p-9">
      <PageHeader title="No fue posible confirmar el acceso" titleClass="text-2xl sm:text-2xl" />
      <Alert variant="destructive" className="mt-5"><AlertDescription>{message}</AlertDescription></Alert>
      <a class={buttonVariants({ size: "lg", className: "mt-6 w-full" })} href="/iniciar-sesion">Volver al inicio de sesión</a>
    </Card>
  </main>
</BaseLayout>
