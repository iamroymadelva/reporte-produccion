---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import AccountPreferences from "../components/account/AccountPreferences";

const auth = Astro.locals.auth!;
const initialTimeFormat = (auth.user.user_metadata as { time_format?: string } | null)?.time_format ?? null;
---

<BaseLayout title="Mi cuenta" description="Preferencias de tu cuenta" profile={auth.profile}>
  <main class="mx-auto w-full max-w-7xl space-y-6 px-4 py-4 sm:px-6 sm:py-6">
    <PageHeader title="Mi cuenta" description="Preferencias personales y seguridad de tu cuenta." />
    <AccountPreferences client:load userId={auth.user.id} initialTimeFormat={initialTimeFormat} />
  </main>
</BaseLayout>
