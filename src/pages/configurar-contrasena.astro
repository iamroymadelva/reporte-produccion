---
import BaseLayout from "../layouts/BaseLayout.astro";

const auth = Astro.locals.auth!;
const error = Astro.url.searchParams.get("error");
---

<BaseLayout title="Configurar contraseña" description="Configuración segura de contraseña" profile={auth.profile}>
  <main class="grid min-h-[calc(100vh-4rem)] place-items-center px-5 py-12">
    <section class="panel w-full max-w-md p-7 sm:p-9">
      <p class="text-sm font-bold uppercase tracking-wider text-emerald-700">Acceso seguro</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight">Configurar contraseña</h1>
      <p class="mt-3 text-slate-600">Usa al menos 8 caracteres para proteger tu cuenta.</p>
      {error && <p class="mt-5 rounded-xl bg-red-50 p-4 text-sm font-medium text-red-800">{error}</p>}
      <form class="mt-7 space-y-5" method="POST" action="/api/auth/password">
        <label>
          <span class="field-label">Nueva contraseña</span>
          <input class="field-control" type="password" name="password" minlength="8" autocomplete="new-password" required />
        </label>
        <label>
          <span class="field-label">Confirmar contraseña</span>
          <input class="field-control" type="password" name="password_confirm" minlength="8" autocomplete="new-password" required />
        </label>
        <button class="button-primary w-full" type="submit">Guardar contraseña</button>
      </form>
    </section>
  </main>
</BaseLayout>
