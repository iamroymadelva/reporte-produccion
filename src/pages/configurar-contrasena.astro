---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Factory } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardFooter, CardHeader } from "@/components/ui/card";
import PasswordField from "../components/PasswordField";

const auth = Astro.locals.auth!;
const error = Astro.url.searchParams.get("error");
---

<BaseLayout title="Configurar contraseña" description="Configuración segura de contraseña" profile={auth.profile}>
  <main class="flex min-h-screen flex-col items-center justify-center gap-4 bg-gradient-to-br from-auth-from via-auth-via to-auth-to p-4">
    <Card className="w-full max-w-md shadow-2xl">
      <CardHeader className="space-y-1">
        <div class="mb-4 flex items-center justify-center">
          <div class="rounded-2xl bg-primary p-4 shadow-lg"><Factory className="h-12 w-12 text-primary-foreground" aria-hidden="true" /></div>
        </div>
        <h1 data-slot="card-title" class="text-center text-2xl leading-none font-bold">Configurar contraseña</h1>
        <CardDescription className="text-center">Usa al menos 8 caracteres para proteger tu cuenta.</CardDescription>
      </CardHeader>
      <form method="POST" action="/api/auth/password">
        <CardContent className="space-y-4">
          {error && <Alert variant="destructive"><AlertDescription>{error}</AlertDescription></Alert>}
          <PasswordField id="setup-password" label="Nueva contraseña" name="password" minLength={8} placeholder="••••••••" />
          <PasswordField id="setup-password-confirm" label="Confirmar contraseña" name="password_confirm" minLength={8} placeholder="••••••••" />
        </CardContent>
        <CardFooter className="mt-4 flex flex-col space-y-4">
          <Button type="submit" size="lg" className="w-full">Guardar contraseña</Button>
        </CardFooter>
      </form>
    </Card>
  </main>
</BaseLayout>
