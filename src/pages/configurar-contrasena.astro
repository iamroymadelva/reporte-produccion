---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { FieldLabel, Label } from "@/components/ui/label";

const auth = Astro.locals.auth!;
const error = Astro.url.searchParams.get("error");
---

<BaseLayout title="Configurar contraseña" description="Configuración segura de contraseña" profile={auth.profile}>
  <main class="grid min-h-[calc(100vh-4rem)] place-items-center px-5 py-12">
    <Card className="w-full max-w-md gap-0 p-7 sm:p-9">
      <PageHeader eyebrow="Acceso seguro" title="Configurar contraseña" description="Usa al menos 8 caracteres para proteger tu cuenta." />
      {error && <Alert variant="destructive" className="mt-5"><AlertDescription>{error}</AlertDescription></Alert>}
      <form class="mt-7 space-y-5" method="POST" action="/api/auth/password">
        <Label>
          <FieldLabel>Nueva contraseña</FieldLabel>
          <Input type="password" name="password" minLength={8} autoComplete="new-password" required />
        </Label>
        <Label>
          <FieldLabel>Confirmar contraseña</FieldLabel>
          <Input type="password" name="password_confirm" minLength={8} autoComplete="new-password" required />
        </Label>
        <button class={buttonVariants({ size: "lg", className: "w-full" })} type="submit">Guardar contraseña</button>
      </form>
    </Card>
  </main>
</BaseLayout>
