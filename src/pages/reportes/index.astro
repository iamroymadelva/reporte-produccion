---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createSupabaseServerClient } from "../../lib/supabase/server";
import { formatDate, getBogotaDateKey } from "../../lib/format";
import { applyReportFilters, parseReportFilters, periodHref, reportFilterParams } from "../../lib/report-filters";
import { roleLabels, statusLabels, type AppRole } from "../../lib/types";

const auth = Astro.locals.auth!;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: reportRows, error: reportError } = await supabase
  .from("production_reports")
  .select("id, folio, report_date, production_order, status, created_by, created_at, machine:machines(id, code, name), operator:profiles!production_reports_created_by_fkey(full_name, role), report_stop_events(id, ended_at)")
  .order("created_at", { ascending: false });

const reports = (reportRows ?? []) as any[];
const drafts = reports.filter((report) => report.status === "DRAFT" && report.created_by === auth.user.id);
const filters = parseReportFilters(Astro.url.searchParams);
const activeFilterLabel = filters.activeStop
  ? "Parada activa"
  : filters.status
    ? statusLabels[filters.status]
    : null;
const hasDisplayFilters = Boolean(filters.period || filters.status || filters.activeStop);
let visibleReports = filters.error ? [] : reports;
let visibleReportError: string | null = null;

if (!filters.error && hasDisplayFilters) {
  const stopsSelection = filters.activeStop
    ? "report_stop_events:report_stop_events!inner(id, ended_at)"
    : "report_stop_events(id, ended_at)";
  let visibleQuery = supabase
    .from("production_reports")
    .select(`id, folio, report_date, production_order, status, created_by, created_at, machine:machines(id, code, name), operator:profiles!production_reports_created_by_fkey(full_name, role), ${stopsSelection}`)
    .order("created_at", { ascending: false });
  visibleQuery = applyReportFilters(visibleQuery, filters);
  const visibleResult = await visibleQuery;
  visibleReports = (visibleResult.data ?? []) as any[];
  visibleReportError = visibleResult.error ? "No fue posible aplicar los filtros de reportes." : null;
}
let assignedMachines: any[] = [];

if (auth.profile.role === "OPERATOR") {
  const { data } = await supabase
    .from("operator_machine_assignments")
    .select("machine_id, active, machine:machines(id, code, name, active)")
    .eq("operator_id", auth.user.id)
    .eq("active", true);
  assignedMachines = (data ?? []).filter((assignment: any) => assignment.machine?.active);
}

const error = Astro.url.searchParams.get("error") ?? filters.error ?? visibleReportError ?? reportError?.message;
const ok = Astro.url.searchParams.get("ok");
const today = getBogotaDateKey();
const currentMonth = today.slice(0, 7);
const exportParams = reportFilterParams(filters);
const exportHref = `/api/reports/export${exportParams.size ? `?${exportParams.toString()}` : ""}`;
const withoutPeriodParams = reportFilterParams(filters, { includePeriod: false });
const clearPeriodHref = `/reportes${withoutPeriodParams.size ? `?${withoutPeriodParams.toString()}` : ""}`;
const filterSummary = [filters.periodLabel, activeFilterLabel].filter(Boolean).join(" · ");
---

<BaseLayout title="Reportes de producción" description="Gestión de reportes de producción" profile={auth.profile}>
  <main class="mx-auto max-w-7xl space-y-6 px-4 py-6 sm:px-6 lg:py-8">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-emerald-700">Operación diaria</p>
        <h1 class="mt-1 text-3xl font-bold tracking-tight">Reportes de producción</h1>
        <p class="mt-2 text-slate-600">
          {auth.profile.role === "OPERATOR" ? `${drafts.length} de 5 reportes abiertos.` : "Consulta de reportes autorizados."}
        </p>
      </div>
      {auth.profile.role === "ADMINISTRATOR" && <a class="button-secondary" href="/administracion">Administración</a>}
    </header>

    {error && <p class="rounded-xl bg-red-50 p-4 font-medium text-red-800">{error}</p>}
    {ok && <p class="rounded-xl bg-emerald-50 p-4 font-medium text-emerald-800">{ok}</p>}

    {auth.profile.role === "OPERATOR" && drafts.length > 0 && (
      <section aria-label="Cambio rápido de máquina">
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-slate-500">Máquinas abiertas</h2>
        <div class="flex gap-3 overflow-x-auto pb-2">
          {drafts.map((report) => {
            const hasOpenStop = report.report_stop_events?.some((stop: any) => !stop.ended_at);
            return (
              <a class="min-w-48 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm hover:border-emerald-500" href={`/reportes/${report.id}`}>
                <span class="font-bold text-slate-900">{report.machine?.code} · {report.machine?.name}</span>
                <span class={`mt-2 block text-xs font-bold ${hasOpenStop ? "text-red-700" : "text-emerald-700"}`}>
                  {hasOpenStop ? "● Parada abierta" : "● En operación"}
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {auth.profile.role === "OPERATOR" && (
      <section class="panel">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-xl font-bold">Abrir reporte de máquina</h2>
            <p class="mt-1 text-sm text-slate-500">Solo aparecen máquinas activas que tienes asignadas.</p>
          </div>
          <span class="rounded-full bg-slate-100 px-3 py-2 text-sm font-semibold">{drafts.length}/5 abiertos</span>
        </div>
        <form class="mt-5 grid gap-4 md:grid-cols-[1fr_220px_auto] md:items-end" method="POST" action="/api/reports">
          <label>
            <span class="field-label">Máquina</span>
            <select class="field-control" name="machine_id" required disabled={drafts.length >= 5}>
              <option value="">Selecciona una máquina</option>
              {assignedMachines.map((assignment) => (
                <option value={assignment.machine.id}>{assignment.machine.code} · {assignment.machine.name}</option>
              ))}
            </select>
          </label>
          <label>
            <span class="field-label">Fecha</span>
            <input class="field-control" type="date" name="report_date" value={today} disabled={drafts.length >= 5} />
          </label>
          <button class="button-primary w-full md:w-auto" type="submit" disabled={drafts.length >= 5}>Nuevo reporte</button>
        </form>
      </section>
    )}

    <section class="panel space-y-4" aria-labelledby="period-filter-title">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 id="period-filter-title" class="text-lg font-bold">Período</h2>
          <p class="mt-1 text-sm text-slate-500">Filtra la tabla por la fecha operativa del reporte.</p>
        </div>
        <div class="grid w-full grid-cols-3 gap-2 sm:flex sm:w-auto sm:flex-wrap" aria-label="Seleccionar tipo de período">
          <a class={`button-secondary px-2 ${filters.period === "day" ? "border-emerald-600 text-emerald-800" : ""}`} href={periodHref("day", filters)}>Día</a>
          <a class={`button-secondary px-2 ${filters.period === "week" ? "border-emerald-600 text-emerald-800" : ""}`} href={periodHref("week", filters)}>Semana</a>
          <a class={`button-secondary px-2 ${filters.period === "month" ? "border-emerald-600 text-emerald-800" : ""}`} href={periodHref("month", filters)}>Mes</a>
        </div>
      </div>

      {filters.period && (
        <form class="grid gap-3 sm:flex sm:flex-wrap sm:items-end" method="GET" action="/reportes">
          <input type="hidden" name="period" value={filters.period} />
          {filters.activeStop && <input type="hidden" name="stop" value="active" />}
          {!filters.activeStop && filters.status && <input type="hidden" name="status" value={filters.status} />}
          {filters.period === "month" ? (
            <label class="min-w-0 flex-1 sm:min-w-56 sm:flex-none">
              <span class="field-label">Mes</span>
              <input class="field-control" type="month" name="month" value={filters.month ?? currentMonth} required />
            </label>
          ) : (
            <label class="min-w-0 flex-1 sm:min-w-56 sm:flex-none">
              <span class="field-label">{filters.period === "week" ? "Fecha dentro de la semana" : "Fecha"}</span>
              <input class="field-control" type="date" name="date" value={filters.date ?? today} required />
            </label>
          )}
          <button class="button-primary w-full sm:w-auto" type="submit">Aplicar</button>
          <a class="button-secondary w-full sm:w-auto" href={clearPeriodHref}>Limpiar período</a>
        </form>
      )}
    </section>

    <section class="panel overflow-hidden p-0">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b p-5">
        <div>
          <h2 class="text-xl font-bold">{auth.profile.role === "OPERATOR" ? "Mis reportes" : "Reportes disponibles"}</h2>
          <p class="mt-1 text-sm text-slate-500">
            Mostrando {visibleReports.length} {visibleReports.length === 1 ? "reporte" : "reportes"}{filterSummary ? ` · ${filterSummary}` : ""}
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          {(auth.profile.role === "ADMINISTRATOR" || auth.profile.role === "VIEWER") && !filters.error && (
            <a class="button-primary" href={exportHref}>Exportar Excel</a>
          )}
          {(activeFilterLabel || filters.period) && <a class="font-bold text-emerald-700 hover:underline" href="/reportes">Limpiar filtros</a>}
        </div>
      </div>
      <div class="mobile-card-list md:hidden">
        {visibleReports.map((report) => {
          const hasOpenStop = report.report_stop_events?.some((stop: any) => !stop.ended_at);
          return (
            <article class="mobile-data-card">
              <div class="flex items-start justify-between gap-3">
                <p class="min-w-0 break-words font-bold text-slate-900">{report.folio}</p>
                <span class={`shrink-0 rounded-full px-3 py-1 text-xs font-semibold ${report.status === "DRAFT" ? "bg-amber-100 text-amber-800" : report.status === "CANCELLED" ? "bg-red-100 text-red-800" : "bg-emerald-100 text-emerald-800"}`}>{statusLabels[report.status as keyof typeof statusLabels]}</span>
              </div>
              <dl class="grid gap-2 text-sm">
                <div><dt class="text-slate-500">Fecha</dt><dd>{formatDate(report.report_date)}</dd></div>
                <div><dt class="text-slate-500">Máquina</dt><dd class="font-semibold">{report.machine?.code} · {report.machine?.name}</dd></div>
                <div><dt class="text-slate-500">Operario</dt><dd>{report.operator?.full_name || "—"}</dd></div>
                {report.production_order && <div><dt class="text-slate-500">O.P.</dt><dd>{report.production_order}</dd></div>}
              </dl>
              <div class="flex min-h-11 items-center justify-between gap-3">
                <span class={hasOpenStop ? "font-bold text-red-700" : "text-slate-500"}>{hasOpenStop ? "● Parada abierta" : "Sin parada activa"}</span>
                <a class="inline-flex min-h-11 items-center rounded-lg px-3 font-bold text-emerald-700" href={`/reportes/${report.id}`}>Abrir</a>
              </div>
            </article>
          );
        })}
        {visibleReports.length === 0 && <p class="p-8 text-center text-slate-500">No hay reportes disponibles.</p>}
      </div>
      <div class="hidden overflow-x-auto md:block" role="region" aria-label="Listado de reportes" tabindex="0">
        <table class="w-full min-w-[760px] text-left text-sm lg:min-w-[960px]">
          <thead class="bg-slate-50 text-slate-600">
            <tr><th class="p-4">Folio</th><th class="p-4">Fecha</th><th class="p-4">Máquina</th><th class="hidden p-4 lg:table-cell">O.P.</th><th class="p-4">Operario</th><th class="hidden p-4 lg:table-cell">Rol</th><th class="p-4">Estado</th><th class="p-4">Parada</th><th class="p-4"></th></tr>
          </thead>
          <tbody>
            {visibleReports.map((report) => {
              const hasOpenStop = report.report_stop_events?.some((stop: any) => !stop.ended_at);
              return (
                <tr class="border-t">
                  <td class="p-4 font-bold text-slate-900">{report.folio}</td>
                  <td class="p-4">{formatDate(report.report_date)}</td>
                  <td class="p-4 font-semibold">{report.machine?.code} · {report.machine?.name}</td>
                  <td class="hidden p-4 lg:table-cell">{report.production_order || "—"}</td>
                  <td class="p-4">{report.operator?.full_name || "—"}</td>
                  <td class="hidden whitespace-nowrap p-4 lg:table-cell">{report.operator?.role ? roleLabels[report.operator.role as AppRole] ?? "—" : "—"}</td>
                  <td class="p-4"><span class={`rounded-full px-3 py-1 font-semibold ${report.status === "DRAFT" ? "bg-amber-100 text-amber-800" : report.status === "CANCELLED" ? "bg-red-100 text-red-800" : "bg-emerald-100 text-emerald-800"}`}>{statusLabels[report.status as keyof typeof statusLabels]}</span></td>
                  <td class="p-4">{hasOpenStop ? <span class="font-bold text-red-700">Abierta</span> : "—"}</td>
                  <td class="p-4 text-right"><a class="font-bold text-emerald-700 hover:underline" href={`/reportes/${report.id}`}>Abrir</a></td>
                </tr>
              );
            })}
            {visibleReports.length === 0 && <tr><td class="p-8 text-center text-slate-500" colspan="9">No hay reportes disponibles.</td></tr>}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</BaseLayout>
