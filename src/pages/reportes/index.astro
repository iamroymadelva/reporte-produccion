---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import StatusBadge from "../../components/StatusBadge";
import StopIndicator from "../../components/StopIndicator";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardDescription, CardHeader } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { FieldLabel, Label } from "@/components/ui/label";
import { NativeSelect } from "@/components/ui/native-select";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { createSupabaseServerClient } from "../../lib/supabase/server";
import { formatDate, getBogotaDateKey } from "../../lib/format";
import { hasActiveStop } from "../../lib/report-status";
import { applyReportFilters, parseReportFilters, periodHref, reportFilterParams } from "../../lib/report-filters";
import { stopDuration, summarizeClosedStops } from "../../lib/stop-events";
import { roleLabels, statusLabels, type AppRole } from "../../lib/types";

const auth = Astro.locals.auth!;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const administrativeList = auth.profile.role === "ADMINISTRATOR" || auth.profile.role === "VIEWER";
const reportSelection = "id, folio, report_date, production_order, product_name, shift, status, created_by, created_at, machine:machines(id, code, name), product:products(id, name), shift_catalog:shifts(id, name, start_time, end_time), operator:profiles!production_reports_created_by_fkey(full_name, role), report_stop_events(id, ended_at, duration_seconds, cancelled_at)";
const PAGE_SIZE = 25;
const requestedPage = Number(Astro.url.searchParams.get("page") ?? "1");
const page = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;
const { data: draftRows, error: draftError } = auth.profile.role === "OPERATOR"
  ? await supabase.from("production_reports").select(reportSelection).eq("status", "DRAFT").eq("created_by", auth.user.id).order("created_at", { ascending: false }).order("id", { ascending: false })
  : { data: [], error: null };
const drafts = (draftRows ?? []) as any[];
const filters = parseReportFilters(Astro.url.searchParams);
const activeFilterLabel = filters.activeStop
  ? "Parada activa"
  : filters.status
    ? statusLabels[filters.status]
    : null;
let visibleReports: any[] = [];
let visibleReportError: string | null = null;
let reportTotal = 0;
if (!filters.error) {
  const visibleSelection = filters.activeStop
    ? `${reportSelection}, active_stop:report_stop_events!inner(id, ended_at)`
    : reportSelection;
  let visibleQuery = supabase
    .from("production_reports")
    .select(visibleSelection, { count: "exact" })
    .order("created_at", { ascending: false })
    .order("id", { ascending: false });
  visibleQuery = applyReportFilters(visibleQuery, filters, filters.activeStop ? "active_stop" : "report_stop_events");
  const visibleResult = await visibleQuery.range((page - 1) * PAGE_SIZE, page * PAGE_SIZE - 1);
  visibleReports = (visibleResult.data ?? []) as any[];
  reportTotal = visibleResult.count ?? 0;
  visibleReportError = visibleResult.error ? "No fue posible aplicar los filtros de reportes." : null;
}
const pageCount = Math.max(1, Math.ceil(reportTotal / PAGE_SIZE));
const pageHref = (target: number) => {
  const params = reportFilterParams(filters);
  if (target > 1) params.set("page", String(target));
  return `/reportes${params.size ? `?${params.toString()}` : ""}`;
};
let assignedMachines: any[] = [];

if (auth.profile.role === "OPERATOR") {
  const { data } = await supabase
    .from("operator_machine_assignments")
    .select("machine_id, active, machine:machines(id, code, name, active)")
    .eq("operator_id", auth.user.id)
    .eq("active", true);
  assignedMachines = (data ?? []).filter((assignment: any) => assignment.machine?.active);
}

// Los resultados de acciones (?ok / ?error) se muestran como toast; aquí solo errores de carga o de filtros.
const error = filters.error ?? visibleReportError ?? draftError?.message;
const today = getBogotaDateKey();
const currentMonth = today.slice(0, 7);
const exportParams = reportFilterParams(filters);
const exportHref = `/api/reports/export${exportParams.size ? `?${exportParams.toString()}` : ""}`;
const withoutPeriodParams = reportFilterParams(filters, { includePeriod: false });
const clearPeriodHref = `/reportes${withoutPeriodParams.size ? `?${withoutPeriodParams.toString()}` : ""}`;
const filterSummary = [filters.periodLabel, activeFilterLabel].filter(Boolean).join(" · ");
const shiftLabel = (report: any) => {
  if (!report.shift_catalog) return report.shift || "—";
  const range = `${String(report.shift_catalog.start_time).slice(0, 5)} - ${String(report.shift_catalog.end_time).slice(0, 5)}`;
  return report.shift_catalog.name ? `${report.shift_catalog.name} · ${range}` : range;
};
---

<BaseLayout title="Reportes de producción" description="Gestión de reportes de producción" profile={auth.profile}>
  <main class="mx-auto w-full max-w-7xl space-y-6 px-4 py-4 sm:px-6 sm:py-6">
    <PageHeader
      title="Reportes de producción"
      description={auth.profile.role === "OPERATOR" ? `${drafts.length} de 5 reportes abiertos.` : "Consulta de reportes autorizados."}
    >
      <Fragment slot="actions">{auth.profile.role === "ADMINISTRATOR" && <a class={buttonVariants({ variant: "outline", size: "lg" })} href="/administracion">Administración</a>}</Fragment>
    </PageHeader>

    {error && <Alert variant="destructive"><AlertDescription>{error}</AlertDescription></Alert>}

    {auth.profile.role === "OPERATOR" && drafts.length > 0 && (
      <section aria-label="Cambio rápido de máquina">
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-muted-foreground">Máquinas abiertas</h2>
        <div class="flex gap-3 overflow-x-auto pb-2">
          {drafts.map((report) => (
            <a class="block min-w-48 rounded-2xl outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50" href={`/reportes/${report.id}`}>
              <Card className="rounded-2xl gap-2 p-4 transition-colors hover:border-primary">
                <span class="font-bold text-foreground">{report.machine?.code} · {report.machine?.name}</span>
                <StopIndicator active={hasActiveStop(report)} variant="inline" />
              </Card>
            </a>
          ))}
        </div>
      </section>
    )}

    {auth.profile.role === "OPERATOR" && (
      <Card className="rounded-2xl gap-0 p-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-semibold leading-none">Abrir reporte de máquina</h2>
            <CardDescription className="mt-1">Solo aparecen máquinas activas que tienes asignadas.</CardDescription>
          </div>
          <Badge variant="neutral" className="px-3 py-2 text-sm">{drafts.length}/5 abiertos</Badge>
        </div>
        <form class="mt-5 grid gap-4 md:grid-cols-[1fr_220px_auto] md:items-end" method="POST" action="/api/reports">
          <Label>
            <FieldLabel>Máquina</FieldLabel>
            <NativeSelect name="machine_id" required disabled={drafts.length >= 5}>
              <option value="">Selecciona una máquina</option>
              {assignedMachines.map((assignment) => (
                <option value={assignment.machine.id}>{assignment.machine.code} · {assignment.machine.name}</option>
              ))}
            </NativeSelect>
          </Label>
          <Label>
            <FieldLabel>Fecha</FieldLabel>
            <Input type="date" name="report_date" value={today} disabled={drafts.length >= 5} />
          </Label>
          <button class={buttonVariants({ variant: "accent", size: "lg", className: "w-full md:w-auto" })} type="submit" disabled={drafts.length >= 5}>Nuevo reporte</button>
        </form>
      </Card>
    )}

    <Card className="rounded-2xl gap-4 p-5" aria-labelledby="period-filter-title">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 id="period-filter-title" class="text-base font-semibold leading-none">Período</h2>
          <CardDescription className="mt-1">Filtra la tabla por la fecha operativa del reporte.</CardDescription>
        </div>
        <div class="grid w-full grid-cols-3 gap-2 sm:flex sm:w-auto sm:flex-wrap" aria-label="Seleccionar tipo de período">
          {([["day", "Día"], ["week", "Semana"], ["month", "Mes"]] as const).map(([value, label]) => (
            <a
              class={buttonVariants({ variant: filters.period === value ? "secondary" : "outline", size: "lg", className: filters.period === value ? "border border-primary px-2" : "px-2" })}
              href={periodHref(value, filters)}
              aria-current={filters.period === value ? "page" : undefined}
            >{label}</a>
          ))}
        </div>
      </div>

      {filters.period && (
        <form class="grid gap-3 sm:flex sm:flex-wrap sm:items-end" method="GET" action="/reportes">
          <input type="hidden" name="period" value={filters.period} />
          {filters.activeStop && <input type="hidden" name="stop" value="active" />}
          {!filters.activeStop && filters.status && <input type="hidden" name="status" value={filters.status} />}
          {filters.period === "month" ? (
            <Label className="min-w-0 flex-1 sm:min-w-56 sm:flex-none">
              <FieldLabel>Mes</FieldLabel>
              <Input type="month" name="month" value={filters.month ?? currentMonth} required />
            </Label>
          ) : (
            <Label className="min-w-0 flex-1 sm:min-w-56 sm:flex-none">
              <FieldLabel>{filters.period === "week" ? "Fecha dentro de la semana" : "Fecha"}</FieldLabel>
              <Input type="date" name="date" value={filters.date ?? today} required />
            </Label>
          )}
          <button class={buttonVariants({ size: "lg", className: "w-full sm:w-auto" })} type="submit">Aplicar</button>
          <a class={buttonVariants({ variant: "outline", size: "lg", className: "w-full sm:w-auto" })} href={clearPeriodHref}>Limpiar período</a>
        </form>
      )}
    </Card>

    <Card className="rounded-2xl gap-0 overflow-hidden py-0">
      <CardHeader className="flex flex-wrap items-center justify-between gap-3 border-b p-5">
        <div>
          <h2 class="text-base font-semibold leading-none">{auth.profile.role === "OPERATOR" ? "Mis reportes" : "Reportes disponibles"}</h2>
          <CardDescription className="mt-1">
            Mostrando {visibleReports.length ? (page - 1) * PAGE_SIZE + 1 : 0}–{Math.min(page * PAGE_SIZE, reportTotal)}{` de ${reportTotal} ${reportTotal === 1 ? "reporte" : "reportes"}`}{filterSummary ? ` · ${filterSummary}` : ""}
          </CardDescription>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          {(auth.profile.role === "ADMINISTRATOR" || auth.profile.role === "VIEWER") && !filters.error && (
            <a class={buttonVariants({ size: "lg" })} href={exportHref}>Exportar Excel</a>
          )}
          {(activeFilterLabel || filters.period) && <a class={buttonVariants({ variant: "link" })} href="/reportes">Limpiar filtros</a>}
        </div>
      </CardHeader>
      <div class={`divide-y divide-border ${administrativeList ? "lg:hidden" : "md:hidden"}`}>
        {visibleReports.map((report) => {
          const stopSummary = summarizeClosedStops(report.report_stop_events ?? []);
          const openStop = hasActiveStop(report);
          return (
            <article class={administrativeList ? "space-y-2 p-3" : "space-y-3 p-4"}>
              <div class="flex items-start justify-between gap-3">
                <p class="min-w-0 break-words font-mono font-semibold tabular-nums text-foreground">{report.folio}</p>
                <StatusBadge status={report.status} />
              </div>
              {administrativeList ? (
                <>
                  <dl class="grid grid-cols-1 gap-x-4 gap-y-2 text-sm min-[380px]:grid-cols-2">
                    <div><dt class="text-muted-foreground">Fecha</dt><dd>{formatDate(report.report_date)}</dd></div>
                    <div><dt class="text-muted-foreground">Máquina</dt><dd class="font-semibold">{report.machine?.code} · {report.machine?.name}</dd></div>
                    <div><dt class="text-muted-foreground">Operario</dt><dd>{report.operator?.full_name || "—"}</dd></div>
                    <div><dt class="text-muted-foreground">Producto</dt><dd>{report.product_name || report.product?.name || "—"}</dd></div>
                    <div><dt class="text-muted-foreground">O.P.</dt><dd>{report.production_order || "—"}</dd></div>
                    <div><dt class="text-muted-foreground">Turno</dt><dd>{shiftLabel(report)}</dd></div>
                  </dl>
                  <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm font-semibold">
                    <span>Paradas: {stopSummary.count}</span>
                    <span>Tiempo total: <span class="font-mono tabular-nums">{stopDuration(stopSummary.seconds)}</span></span>
                  </div>
                  <div class="flex min-h-11 items-center justify-between gap-3 border-t border-border pt-1">
                    <span>{openStop && <StopIndicator active variant="inline" className="text-sm" />}</span>
                    <a class={buttonVariants({ variant: "ghost", className: "font-bold text-primary hover:text-primary" })} href={`/reportes/${report.id}`}>Abrir</a>
                  </div>
                </>
              ) : (
                <>
                  <dl class="grid gap-2 text-sm">
                    <div><dt class="text-muted-foreground">Fecha</dt><dd>{formatDate(report.report_date)}</dd></div>
                    <div><dt class="text-muted-foreground">Máquina</dt><dd class="font-semibold">{report.machine?.code} · {report.machine?.name}</dd></div>
                    <div><dt class="text-muted-foreground">Operario</dt><dd>{report.operator?.full_name || "—"}</dd></div>
                    {report.production_order && <div><dt class="text-muted-foreground">O.P.</dt><dd>{report.production_order}</dd></div>}
                  </dl>
                  <div class="flex min-h-11 items-center justify-between gap-3">
                    {openStop ? <StopIndicator active variant="inline" className="text-sm" /> : <span class="text-muted-foreground">Sin parada activa</span>}
                    <a class={buttonVariants({ variant: "ghost", className: "font-bold text-primary hover:text-primary" })} href={`/reportes/${report.id}`}>Abrir</a>
                  </div>
                </>
              )}
            </article>
          );
        })}
        {visibleReports.length === 0 && <p class="p-8 text-center text-muted-foreground">No hay reportes disponibles.</p>}
      </div>
      <Table className="min-w-[760px] lg:min-w-[960px]" container={{ role: "region", "aria-label": "Listado de reportes", tabIndex: 0, className: `hidden ${administrativeList ? "lg:block" : "md:block"}` }}>
        <TableHeader>
          <TableRow>
            <TableHead>Folio</TableHead><TableHead>Fecha</TableHead><TableHead>Máquina</TableHead><TableHead className="hidden lg:table-cell">O.P.</TableHead><TableHead>Operario</TableHead><TableHead className="hidden lg:table-cell">Rol</TableHead><TableHead>Estado</TableHead><TableHead>Parada</TableHead><TableHead><span class="sr-only">Acciones</span></TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {visibleReports.map((report) => (
            <TableRow>
              <TableCell className="font-mono font-semibold tabular-nums text-foreground">{report.folio}</TableCell>
              <TableCell>{formatDate(report.report_date)}</TableCell>
              <TableCell className="font-semibold">{report.machine?.code} · {report.machine?.name}</TableCell>
              <TableCell className="hidden lg:table-cell">{report.production_order || "—"}</TableCell>
              <TableCell>{report.operator?.full_name || "—"}</TableCell>
              <TableCell className="hidden whitespace-nowrap lg:table-cell">{report.operator?.role ? roleLabels[report.operator.role as AppRole] ?? "—" : "—"}</TableCell>
              <TableCell><StatusBadge status={report.status} /></TableCell>
              <TableCell>{hasActiveStop(report) ? <StopIndicator active /> : "—"}</TableCell>
              <TableCell className="text-right"><a class="font-semibold text-primary underline-offset-4 hover:underline" href={`/reportes/${report.id}`}>Abrir</a></TableCell>
            </TableRow>
          ))}
          {visibleReports.length === 0 && <TableRow><TableCell className="p-8 text-center text-muted-foreground" colSpan={9}>No hay reportes disponibles.</TableCell></TableRow>}
        </TableBody>
      </Table>
      {pageCount > 1 && (
        <nav class="flex flex-wrap items-center justify-between gap-3 border-t px-4 py-3" aria-label="Páginas de reportes">
          <a class={buttonVariants({ variant: "outline", size: "lg" })} href={pageHref(Math.max(1, page - 1))} aria-disabled={page <= 1 ? "true" : undefined}>Anterior</a>
          <span class="text-sm font-medium text-muted-foreground">Página {page} de {pageCount}</span>
          <a class={buttonVariants({ variant: "outline", size: "lg" })} href={pageHref(Math.min(pageCount, page + 1))} aria-disabled={page >= pageCount ? "true" : undefined}>Siguiente</a>
        </nav>
      )}
    </Card>
  </main>
</BaseLayout>
