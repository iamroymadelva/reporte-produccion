---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OfflineDraftNotice from "../../components/OfflineDraftNotice";
import PageHeader from "../../components/PageHeader.astro";
import StatusBadge from "../../components/StatusBadge";
import StopIndicator from "../../components/StopIndicator";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card } from "@/components/ui/card";
import { cn } from "@/lib/utils";
import ReportEditor from "../../components/ReportEditor";
import StopManager from "../../components/StopManager";
import StopEventsTable from "../../components/StopEventsTable";
import StopSummary from "../../components/StopSummary";
import { describeAuditRows, type AuditCatalogs, type ReportAuditRow } from "../../lib/report-audit";
import { STOP_EVENT_SELECTION, isActiveStop } from "../../lib/stop-events";
import { createSupabaseServerClient } from "../../lib/supabase/server";
import { formatDateTime, formatDuration, formatNumber, formatPercent } from "../../lib/format";
import { hasActiveStop } from "../../lib/report-status";
import { roleLabels } from "../../lib/types";

const auth = Astro.locals.auth!;
const isOperator = auth.profile.role === "OPERATOR";
const id = Astro.params.id!;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);

const [reportResult, metricsResult, stopsResult, linesResult, clientsResult, productsResult, dosifiersResult, shiftsResult, categoriesResult] = await Promise.all([
  supabase.from("production_reports").select("*, machine:machines(id, code, name), line:lines(id, code, name), client:clients(id, code, name), product:products(id, code, name), dosifier_type:dosifier_types(id, code, name), shift_catalog:shifts(id, name, start_time, end_time), operator:profiles!production_reports_created_by_fkey(id, full_name, job_title, role), cancelled_by_profile:profiles!production_reports_cancelled_by_fkey(id, full_name)").eq("id", id).single(),
  isOperator ? Promise.resolve({ data: null }) : supabase.from("production_report_metrics").select("*").eq("id", id).single(),
  supabase.from("report_stop_events").select(STOP_EVENT_SELECTION).eq("report_id", id).order("started_at"),
  supabase.from("lines").select("id, code, name, active").order("name").order("code"),
  supabase.from("clients").select("id, code, name, active").order("name").order("code"),
  supabase.from("products").select("id, code, name, active").order("name").order("code"),
  supabase.from("dosifier_types").select("id, code, name, active").order("name").order("code"),
  supabase.from("shifts").select("id, name, start_time, end_time, active").order("start_time").order("end_time"),
  supabase.from("stop_categories").select("id, code, name, numeric_code, active").order("numeric_code").order("code"),
]);

if (reportResult.error || !reportResult.data) return Astro.redirect("/reportes?error=Reporte no encontrado");
if (stopsResult.error) throw new Error("No fue posible consultar las paradas del reporte.");
const report = reportResult.data as any;
const metrics = (metricsResult.data ?? {}) as any;
const stops = (stopsResult.data ?? []) as any[];
const lines = (linesResult.data ?? []) as any[];
const clients = (clientsResult.data ?? []) as any[];
const products = (productsResult.data ?? []) as any[];
const dosifierTypes = (dosifiersResult.data ?? []) as any[];
const shifts = (shiftsResult.data ?? []) as any[];
const categories = (categoriesResult.data ?? []) as any[];
const isOwnerDraft = auth.profile.role === "OPERATOR" && report.created_by === auth.user.id && report.status === "DRAFT";
const adminCorrection = auth.profile.role === "ADMINISTRATOR";
const editable = isOwnerDraft || adminCorrection;
const shiftLabel = (shift: any) => {
  if (!shift) return report.shift || "—";
  const range = `${String(shift.start_time).slice(0, 5)} - ${String(shift.end_time).slice(0, 5)}`;
  return shift.name ? `${shift.name} · ${range}` : range;
};

let openDrafts: any[] = [];
if (auth.profile.role === "OPERATOR") {
  const { data } = await supabase
    .from("production_reports")
    .select("id, machine:machines(code, name), report_stop_events(id, ended_at, cancelled_at)")
    .eq("created_by", auth.user.id)
    .eq("status", "DRAFT")
    .order("created_at");
  openDrafts = (data ?? []) as any[];
}

let audit: ReportAuditRow[] = [];
let auditError: string | null = null;
if (auth.profile.role === "ADMINISTRATOR" || auth.profile.role === "VIEWER") {
  const { data, error } = await supabase
    .from("report_audit_log")
    .select("id, changed_at, changed_by, field_name, old_value, new_value, user:profiles!report_audit_log_changed_by_fkey(full_name)")
    .eq("report_id", id)
    .order("changed_at", { ascending: false });
  audit = (data ?? []) as unknown as ReportAuditRow[];
  auditError = error ? "No fue posible consultar la auditoría del reporte." : null;
}

const catalogMap = (rows: any[], label: (row: any) => string) => new Map(
  rows.map((row) => [row.id, label(row)]),
);
const codeName = (row: any) => [row.code, row.name].filter(Boolean).join(" · ");
const auditCatalogs: AuditCatalogs = {
  machine_id: new Map([[report.machine_id, `${report.machine?.code} · ${report.machine?.name}`]]),
  line_id: catalogMap(lines, codeName),
  client_id: catalogMap(clients, codeName),
  product_id: catalogMap(products, codeName),
  dosifier_type_id: catalogMap(dosifierTypes, codeName),
  shift_id: catalogMap(shifts, (shift) => shiftLabel(shift)),
  stop_category_id: catalogMap(categories, codeName),
};
const auditEntries = describeAuditRows(audit, { catalogs: auditCatalogs, stops });
---

<BaseLayout title={report.folio} description="Detalle del reporte de producción" profile={auth.profile}>
  <main class="mx-auto w-full max-w-7xl space-y-6 px-4 py-4 sm:px-6 sm:py-6">
    {openDrafts.length > 0 && (
      <nav class="flex gap-2 overflow-x-auto rounded-xl border bg-card p-2" aria-label="Reportes abiertos por máquina">
        {openDrafts.map((draft) => (
          <a
            class={cn("min-w-44 rounded-xl px-4 py-3 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50", draft.id === id ? "bg-primary text-primary-foreground" : "bg-muted text-foreground hover:bg-muted/70")}
            href={`/reportes/${draft.id}`}
            aria-current={draft.id === id ? "page" : undefined}
          >
            <span class="block font-bold">{draft.machine?.code} · {draft.machine?.name}</span>
            <StopIndicator className="mt-1" reportId={draft.id} current={draft.id === id} active={hasActiveStop(draft)} variant="inline" />
          </a>
        ))}
      </nav>
    )}

    <PageHeader
      title={report.folio}
      titleClass="font-mono tabular-nums"
      back={{ href: "/reportes", label: "Volver a reportes" }}
    >
      <p class="text-lg font-semibold text-foreground">{report.machine?.code} · {report.machine?.name}</p>
      <p class="mt-1 text-muted-foreground">Operario: {report.creator_full_name}</p>
      <Fragment slot="actions"><StatusBadge status={report.status} /></Fragment>
    </PageHeader>

    {(auth.profile.role === "ADMINISTRATOR" || auth.profile.role === "VIEWER") && (
      <Card className="rounded-2xl grid gap-4 p-5 sm:grid-cols-3" aria-label="Responsable del reporte">
        <div><p class="text-sm text-muted-foreground">Creador del reporte</p><p class="font-bold">{report.creator_full_name}</p></div>
        <div><p class="text-sm text-muted-foreground">Cargo al crear el reporte</p><p class="font-bold">{report.creator_job_title || "—"}</p></div>
        <div><p class="text-sm text-muted-foreground">Rol al crear el reporte</p><p class="font-bold">{roleLabels[report.creator_role as keyof typeof roleLabels]}</p></div>
      </Card>
    )}

    {report.status === "CANCELLED" && (
      <Card className="rounded-2xl gap-0 border-destructive/30 bg-destructive/10 p-5">
        <h2 class="text-xl font-bold text-destructive">Reporte cancelado</h2>
        <dl class="mt-4 grid gap-4 sm:grid-cols-3">
          <div class="sm:col-span-3"><dt class="text-sm text-muted-foreground">Motivo de cancelación</dt><dd class="font-semibold text-foreground">{report.cancellation_reason}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Usuario que canceló</dt><dd class="font-semibold text-foreground">{report.cancelled_by_profile?.full_name || "—"}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Fecha y hora de cancelación</dt><dd class="font-semibold text-foreground">{formatDateTime(report.cancelled_at)}</dd></div>
        </dl>
      </Card>
    )}

    {auth.profile.role === "OPERATOR" && !isOwnerDraft && (
      <OfflineDraftNotice
        client:load
        userId={auth.user.id}
        reportId={id}
        finalized
      />
    )}

    {!isOperator && <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <Card className="rounded-2xl gap-0 p-5"><p class="text-sm text-muted-foreground">Unidades teóricas/hora</p><p class="mt-2 font-mono text-2xl font-bold tabular-nums">{formatNumber(metrics.theoretical_units_per_hour)}</p></Card>
      <Card className="rounded-2xl gap-0 p-5"><p class="text-sm text-muted-foreground">Tiempo total de parada</p><p class="mt-2 font-mono text-2xl font-bold tabular-nums">{formatDuration(metrics.total_downtime_seconds)}</p></Card>
      <Card className="rounded-2xl gap-0 p-5"><p class="text-sm text-muted-foreground">Rendimiento teórico</p><p class="mt-2 font-mono text-2xl font-bold tabular-nums">{formatPercent(metrics.theoretical_performance)}</p></Card>
      <Card className="rounded-2xl gap-0 p-5"><p class="text-sm text-muted-foreground">Rendimiento neto</p><p class="mt-2 font-mono text-2xl font-bold tabular-nums">{formatPercent(metrics.net_performance)}</p></Card>
    </section>}

    {isOwnerDraft && (
      <StopManager client:load reportId={id} stops={stops} categories={categories.filter((category) => category.active)} />
    )}

    {editable ? (
      <ReportEditor
        client:load
        report={report}
        lines={lines.filter((line) => line.active)}
        clients={clients.filter((client) => client.active)}
        products={products.filter((product) => product.active)}
        dosifierTypes={dosifierTypes.filter((dosifier) => dosifier.active)}
        shifts={shifts.filter((shift) => shift.active)}
        canSubmit={isOwnerDraft}
        hasActiveStop={stops.some(isActiveStop)}
        adminCorrection={adminCorrection && report.status !== "DRAFT"}
        offlinePersistence={isOwnerDraft}
        authenticatedUserId={isOwnerDraft ? auth.user.id : undefined}
        serverUpdatedAt={isOwnerDraft ? report.updated_at : undefined}
        reportFolio={isOwnerDraft ? report.folio : undefined}
        machineId={isOwnerDraft ? report.machine_id : undefined}
        machineLabel={isOwnerDraft ? `${report.machine?.code} · ${report.machine?.name}` : undefined}
      />
    ) : (
      <Card className="rounded-2xl gap-0 p-5">
        <h2 class="text-base font-semibold leading-none">Datos del reporte</h2>
        <dl class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {isOperator && <>
            <div><dt class="text-sm text-muted-foreground">Máquina</dt><dd class="font-semibold">{report.machine?.code} · {report.machine?.name}</dd></div>
            <div><dt class="text-sm text-muted-foreground">Operario responsable</dt><dd class="font-semibold">{report.creator_full_name}</dd></div>
          </>}
          <div><dt class="text-sm text-muted-foreground">Fecha</dt><dd class="font-semibold">{report.report_date || "—"}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Producto</dt><dd class="font-semibold">{report.product_name || report.product?.name || "—"}</dd></div>
          <div><dt class="text-sm text-muted-foreground">O.P.</dt><dd class="font-semibold">{report.production_order || "—"}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Área / Línea</dt><dd class="font-semibold">{report.line?.name || "—"}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Cliente</dt><dd class="font-semibold">{report.client_name || report.client?.name || "—"}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Lote</dt><dd class="font-semibold">{report.lot || "—"}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Turno</dt><dd class="font-semibold">{shiftLabel(report.shift_catalog)}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Peso (gr)</dt><dd class="font-mono font-semibold tabular-nums">{formatNumber(report.weight)}</dd></div>
          <div><dt class="text-sm text-muted-foreground">G/min</dt><dd class="font-mono font-semibold tabular-nums">{formatNumber(report.g_min)}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Tipo de dosificador</dt><dd class="font-semibold">{report.dosifier_type?.name || "—"}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Hora inicio</dt><dd class="font-semibold">{formatDateTime(report.started_at)}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Hora finalización</dt><dd class="font-semibold">{formatDateTime(report.ended_at)}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Horas programadas</dt><dd class="font-mono font-semibold tabular-nums">{formatNumber(report.programmed_hours)}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Unidades producidas</dt><dd class="font-mono font-semibold tabular-nums">{formatNumber(report.units_produced, 0)}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Desperdicio</dt><dd class="font-mono font-semibold tabular-nums">{formatNumber(report.waste)}</dd></div>
          <div class="sm:col-span-2 lg:col-span-3"><dt class="text-sm text-muted-foreground">Observaciones</dt><dd class="font-semibold">{report.observations || "—"}</dd></div>
        </dl>
      </Card>
    )}

    {!isOwnerDraft && (
      <Card className="rounded-2xl gap-0 p-5">
        <h2 class="text-base font-semibold leading-none">Paradas registradas</h2>
        {isOperator && <div class="mt-4"><StopSummary stops={stops} /></div>}
        <div class="mt-4"><StopEventsTable client:load stops={stops} chronologicalOnly={isOperator} /></div>
      </Card>
    )}

    {(auth.profile.role === "ADMINISTRATOR" || auth.profile.role === "VIEWER") && (
      <Card className="rounded-2xl gap-0 p-5" aria-labelledby="report-audit-title">
        <h2 id="report-audit-title" class="text-base font-semibold leading-none">Auditoría de correcciones</h2>
        {auditError ? (
          <Alert variant="destructive" className="mt-4"><AlertDescription>{auditError}</AlertDescription></Alert>
        ) : (
          <div class="mt-4 space-y-3">
            {auditEntries.map((entry) => (
              <article class="rounded-xl bg-muted/50 p-4 text-sm">
                <div class="flex flex-wrap items-start justify-between gap-2">
                  <h3 class="font-bold text-foreground">{entry.title}{entry.stopNumber ? ` · Parada #${entry.stopNumber}` : ""}</h3>
                  <time class="text-muted-foreground" datetime={entry.changedAt}>{formatDateTime(entry.changedAt)}</time>
                </div>
                <p class="mt-1 text-muted-foreground"><span class="font-semibold text-foreground">Actor:</span> {entry.actor}</p>
                <div class="mt-3 space-y-3">
                  {entry.details.map((detail) => (
                    <div class="grid gap-2 border-t border-border pt-3 min-[420px]:grid-cols-2">
                      <p class="font-semibold text-foreground min-[420px]:col-span-2">{detail.label}</p>
                      {detail.previous !== undefined && <dl><dt class="text-xs uppercase tracking-wide text-muted-foreground">Valor anterior</dt><dd class="mt-1 break-words text-foreground">{detail.previous}</dd></dl>}
                      {detail.next !== undefined && <dl><dt class="text-xs uppercase tracking-wide text-muted-foreground">Valor nuevo</dt><dd class="mt-1 break-words text-foreground">{detail.next}</dd></dl>}
                    </div>
                  ))}
                </div>
              </article>
            ))}
            {auditEntries.length === 0 && <p class="text-sm text-muted-foreground">No hay correcciones registradas.</p>}
          </div>
        )}
      </Card>
    )}
  </main>
</BaseLayout>

<script>
  import { REPORT_STOPS_CHANGED } from "../../lib/stop-events";
  import { STOP_ACTIVE_LABEL, STOP_IDLE_LABEL } from "../../lib/report-status";

  type StopsChangedDetail = { reportId: string; active: boolean };
  type StopsWindow = Window & { __reportStopsListenerBound?: boolean };

  function onStopsChanged(event: Event) {
    const { reportId, active } = (event as CustomEvent<StopsChangedDetail>).detail;
    for (const indicator of document.querySelectorAll<HTMLElement>("[data-stop-report-id]")) {
      if (indicator.dataset.stopReportId !== reportId) continue;
      indicator.dataset.active = String(active);
      const label = indicator.querySelector<HTMLElement>("[data-stop-label]");
      if (label) label.textContent = active ? STOP_ACTIVE_LABEL : STOP_IDLE_LABEL;
    }
  }

  // El listener es global (window): se registra una sola vez aunque ClientRouter vuelva a
  // disparar astro:page-load en cada navegación.
  function bindStopsListener() {
    const target = window as StopsWindow;
    if (target.__reportStopsListenerBound) return;
    target.__reportStopsListenerBound = true;
    window.addEventListener(REPORT_STOPS_CHANGED, onStopsChanged);
  }

  document.addEventListener("astro:page-load", bindStopsListener);
  bindStopsListener();
</script>
