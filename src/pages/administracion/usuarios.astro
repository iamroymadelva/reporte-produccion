---
import AdminSearch from "../../components/AdminSearch.astro";
import AdminRecordModal from "../../components/AdminRecordModal.astro";
import PageHeader from "../../components/PageHeader.astro";
import UserAssignmentsField from "../../components/UserAssignmentsField.astro";
import UserDeactivationPanel from "../../components/UserDeactivationPanel.astro";
import PasswordField from "../../components/PasswordField";
import UserPasswordResetAction from "../../components/UserPasswordResetAction.astro";
import UserReactivateAction from "../../components/UserReactivateAction.astro";
import UserRetireAction from "../../components/UserRetireAction.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { FieldLabel, Label } from "@/components/ui/label";
import { NativeSelect } from "@/components/ui/native-select";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { createSupabaseServerClient } from "../../lib/supabase/server";
import { readAllPages } from "../../lib/supabase/read-all-pages";
import { roleLabels, type AppRole } from "../../lib/types";
import { canManage, creatableRoles, MIN_PASSWORD_LENGTH } from "../../lib/user-admin";
const auth = Astro.locals.auth!;
const actorRole = auth.profile.role;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const [{ data: profilesData, error: profilesError }, { data: machinesData, error: machinesError }, { data: shiftsData, error: shiftsError }, { data: assignmentsData, error: assignmentsError }] = await Promise.all([
  readAllPages((start, end) => supabase.from("profiles").select("id, username, full_name, role, job_title, active, removed_at, removed_by, possible_unsynced_data").order("full_name").order("id").range(start, end)),
  readAllPages((start, end) => supabase.from("machines").select("id, code, name, active").eq("active", true).order("code").order("name").order("id").range(start, end)),
  readAllPages((start, end) => supabase.from("shifts").select("id, name, start_time, end_time, active, sort_order").eq("active", true).order("sort_order").order("start_time").order("id").range(start, end)),
  readAllPages((start, end) => supabase.from("operator_machine_assignments").select("id, operator_id, machine_id, shift_id, valid_from, valid_to").eq("active", true).order("operator_id").order("machine_id").order("shift_id").range(start, end)),
]);
const profiles = (profilesData ?? []) as any[];
const machines = (machinesData ?? []) as any[];
const shifts = (shiftsData ?? []) as any[];
const assignments = (assignmentsData ?? []) as any[];
const machineById = new Map(machines.map((machine) => [machine.id, machine]));
const shiftLabel = (shift: any) => shift.name?.trim() || `${String(shift.start_time).slice(0, 5)}–${String(shift.end_time).slice(0, 5)}`;
const shiftById = new Map(shifts.map((shift) => [shift.id, shift]));
const error = (profilesError || machinesError || shiftsError || assignmentsError) ? "No fue posible cargar todos los usuarios y asignaciones." : null;
const createRoles = creatableRoles(actorRole);
const allRoles = Object.keys(roleLabels) as AppRole[];
---

<BaseLayout title="Usuarios" description="Administración de usuarios y asignaciones" profile={auth.profile}>
  <main class="mx-auto w-full max-w-7xl space-y-6 px-4 py-4 sm:px-6 sm:py-6" data-search-scope>
    <PageHeader title="Usuarios y asignaciones" back={{ href: "/administracion", label: "Administración" }}>
      <AdminRecordModal slot="actions" id="create-user" title="Nuevo usuario" action="/api/admin/users" submitLabel="Crear usuario" mode="create" size="large" description="Crea el usuario con una contraseña inicial que se la comunicas directamente.">
        <div class="grid gap-4 md:grid-cols-2">
          <Label><FieldLabel>Usuario</FieldLabel><Input name="username" autoComplete="off" autoCapitalize="none" spellCheck={false} pattern="[a-z0-9._\-]{3,32}" minLength={3} maxLength={32} required /><span class="mt-1 block text-xs text-muted-foreground">3 a 32 caracteres: minúsculas, números, punto, guion o guion bajo. No se puede cambiar después.</span></Label>
          <Label><FieldLabel>Nombre completo</FieldLabel><Input name="full_name" required /></Label>
          <Label><FieldLabel>Cargo</FieldLabel><Input name="job_title" /></Label>
          <Label><FieldLabel>Rol</FieldLabel><NativeSelect name="role">{createRoles.map((role) => <option value={role}>{roleLabels[role]}</option>)}</NativeSelect></Label>
          <PasswordField id="create-user-password" label="Contraseña inicial" name="password" minLength={MIN_PASSWORD_LENGTH} />
          <PasswordField id="create-user-password-confirm" label="Confirmar contraseña" name="password_confirm" minLength={MIN_PASSWORD_LENGTH} />
        </div>
        <UserAssignmentsField machines={machines} shifts={shifts} />
      </AdminRecordModal>
    </PageHeader>
    {error && <Alert variant="destructive"><AlertDescription>{error}</AlertDescription></Alert>}
    <Label className="block max-w-lg"><FieldLabel>Buscar</FieldLabel><Input type="search" enterKeyHint="search" placeholder="Buscar usuarios" data-search-input /></Label>
    <Card className="rounded-2xl gap-0 overflow-hidden py-0">
      <Table className="responsive-admin-table responsive-admin-table--wide min-w-[1040px]">
        <TableHeader><TableRow><TableHead>Usuario</TableHead><TableHead>Nombre</TableHead><TableHead>Rol</TableHead><TableHead>Estado</TableHead><TableHead>Asignaciones</TableHead><TableHead className="text-right">Acción</TableHead></TableRow></TableHeader>
        <TableBody>
          {profiles.map((profile) => {
            const own = assignments.filter((item) => item.operator_id === profile.id);
            const selected = own.map((item) => `${item.machine_id}:${item.shift_id}`);
            const byMachine = new Map<string, string[]>();
            for (const item of own) {
              const machine = machineById.get(item.machine_id);
              const shift = shiftById.get(item.shift_id);
              if (!machine || !shift) continue;
              byMachine.set(machine.code, [...(byMachine.get(machine.code) ?? []), shiftLabel(shift)]);
            }
            const assignedText = [...byMachine.entries()].map(([code, labels]) => `${code} (${labels.join(", ")})`).join("; ");
            const retired = !profile.active && Boolean(profile.removed_at);
            const status = retired ? "Retirado" : profile.active ? "Activo" : "Inactivo";
            const manageable = canManage(actorRole, profile.role as AppRole);
            const isSelf = profile.id === auth.user.id;
            const roleOptions = actorRole === "ROOT" ? allRoles : (["OPERATOR"] as AppRole[]);
            return (
              <TableRow data-search-row data-search-text={`${profile.username} ${profile.full_name} ${profile.job_title ?? ""} ${roleLabels[profile.role as AppRole]} ${status} ${assignedText}`}>
                <TableCell className="font-mono font-semibold" data-label="Usuario">{profile.username}</TableCell>
                <TableCell data-label="Nombre">{profile.full_name}{profile.job_title && <span class="block text-xs text-muted-foreground">{profile.job_title}</span>}</TableCell>
                <TableCell data-label="Rol">{roleLabels[profile.role as AppRole]}</TableCell>
                <TableCell data-label="Estado"><Badge variant={profile.active ? "submitted" : retired ? "cancelled" : "neutral"}>{status}</Badge>{profile.possible_unsynced_data && <Badge variant="cancelled" className="ml-1">Posibles datos sin subir</Badge>}</TableCell>
                <TableCell data-label="Asignaciones">{assignedText || "—"}</TableCell>
                <TableCell className="text-right" data-label="Acciones">
                  <div class="flex flex-wrap items-center justify-end gap-2">
                    {!manageable ? null : retired ? (
                      <UserReactivateAction userId={profile.id} userName={profile.full_name} role={profile.role as AppRole} machines={machines} shifts={shifts} />
                    ) : (
                      <>
                        <AdminRecordModal id={`edit-user-${profile.id}`} title="Editar usuario" action={`/api/admin/users/${profile.id}`} submitLabel="Guardar cambios" mode="edit" size="large">
                          <input type="hidden" name="intent" value="update" />
                          <div class="grid gap-3 sm:grid-cols-2">
                            <Label><FieldLabel>Usuario</FieldLabel><Input value={profile.username} readOnly disabled /></Label>
                            <Label><FieldLabel>Nombre</FieldLabel><Input name="full_name" value={profile.full_name} required /></Label>
                            <Label><FieldLabel>Cargo</FieldLabel><Input name="job_title" value={profile.job_title ?? ""} /></Label>
                            <Label><FieldLabel>Rol</FieldLabel><NativeSelect name="role">{roleOptions.map((role) => <option value={role} selected={role === profile.role}>{roleLabels[role]}</option>)}</NativeSelect></Label>
                          </div>
                          <UserAssignmentsField machines={machines} shifts={shifts} selected={selected} optIn />
                          <Label className="mt-4 flex min-h-12 items-center gap-3"><input class="size-5 accent-primary" type="checkbox" name="active" checked={profile.active} data-initial-active={profile.active ? "1" : "0"} /><span class="font-semibold">Usuario activo</span></Label>
                          <UserDeactivationPanel userId={profile.id} panelId={`edit-user-${profile.id}`} canForce={actorRole === "ROOT"} hidden />
                        </AdminRecordModal>
                        <UserPasswordResetAction userId={profile.id} userName={profile.full_name} username={profile.username} />
                        {!isSelf && <UserRetireAction userId={profile.id} recordName={`${profile.full_name} · ${profile.username}`} canForce={actorRole === "ROOT"} />}
                      </>
                    )}
                  </div>
                </TableCell>
              </TableRow>
            );
          })}
          {profiles.length === 0 && <TableRow><TableCell className="p-8 text-center text-muted-foreground" colSpan={6}>No hay usuarios configurados.</TableCell></TableRow>}
        </TableBody>
      </Table>
    </Card>
    <AdminSearch />
  </main>
</BaseLayout>

<script>
  // FR-005a / T113: al abrir "Retirar usuario", o al desmarcar "Usuario activo" en la edición, se consulta el
  // último contacto, los pendientes y el reporte activo. AdminDialogHost pinta las plantillas de forma asíncrona.
  type LastContact = { lastSeenAt: string | null; pendingCount: number; activeReportId: string | null };

  const scopeOf = (panel: HTMLElement) => panel.closest("form") ?? panel;

  // Estado de los controles según bloqueo y anulación de ROOT.
  function refresh(panel: HTMLElement) {
    const scope = scopeOf(panel);
    const confirm = panel.querySelector<HTMLInputElement>("[data-retire-confirm]");
    const submit = scope.querySelector<HTMLButtonElement>("button[type=submit]");
    const forceWrap = panel.querySelector<HTMLElement>("[data-force-wrap]");
    const toggle = panel.querySelector<HTMLInputElement>("[data-force-toggle]");
    const reason = panel.querySelector<HTMLInputElement>("[data-force-reason]");
    const loaded = panel.dataset.loaded === "1";
    const blocked = panel.dataset.blocked === "1";
    forceWrap?.classList.toggle("hidden", !blocked);
    const forced = blocked && Boolean(toggle?.checked);
    if (toggle && !blocked) toggle.checked = false;
    if (reason) { reason.disabled = !forced; reason.required = forced; }
    const allowed = loaded && (!blocked || forced);
    if (confirm) { confirm.disabled = !allowed; confirm.required = allowed && !panel.classList.contains("hidden"); }
    if (submit) submit.disabled = !allowed;
  }

  function fill(panel: HTMLElement, data: LastContact | null) {
    const set = (selector: string, text: string) => { const el = panel.querySelector<HTMLElement>(selector); if (el) el.textContent = text; };
    if (!data) {
      set("[data-lc-last]", "No disponible");
      panel.querySelector("[data-lc-error]")?.classList.remove("hidden");
      panel.dataset.loaded = "0";
      refresh(panel);
      return;
    }
    set("[data-lc-last]", data.lastSeenAt ? new Date(data.lastSeenAt).toLocaleString("es-CO", { timeZone: "America/Bogota", dateStyle: "medium", timeStyle: "short" }) : "Sin contacto registrado");
    set("[data-lc-pending]", String(data.pendingCount));
    set("[data-lc-report]", data.activeReportId ? "Sí" : "No");
    const blocked = data.pendingCount > 0 || Boolean(data.activeReportId);
    panel.querySelector("[data-lc-blocked]")?.classList.toggle("hidden", !blocked);
    panel.dataset.blocked = blocked ? "1" : "0";
    panel.dataset.loaded = "1";
    refresh(panel);
  }

  async function load(panel: HTMLElement) {
    const url = panel.dataset.lastContactUrl;
    if (!url) return;
    panel.dataset.loaded = "0";
    refresh(panel);
    try {
      const response = await fetch(url, { headers: { Accept: "application/json" }, credentials: "same-origin" });
      if (!response.ok) throw new Error(String(response.status));
      fill(panel, (await response.json()) as LastContact);
    } catch {
      fill(panel, null);
    }
  }

  // Diálogo "Retirar usuario": el panel aparece cuando el host pinta la plantilla.
  document.addEventListener("click", (event) => {
    const trigger = event.target instanceof Element ? event.target.closest<HTMLElement>("button[data-last-contact-url]") : null;
    if (!trigger?.dataset.modalOpen) return;
    const selector = `[data-deactivation-panel="${trigger.dataset.modalOpen}"]`;
    const tryLoad = () => {
      const panel = document.querySelector<HTMLElement>(selector);
      if (!panel) return false;
      void load(panel);
      return true;
    };
    if (tryLoad()) return;
    const observer = new MutationObserver(() => { if (tryLoad()) observer.disconnect(); });
    observer.observe(document.body, { childList: true, subtree: true });
    window.setTimeout(() => observer.disconnect(), 5000);
  });

  document.addEventListener("change", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement)) return;
    // "Forzar de todos modos" (solo ROOT).
    if (target.matches("[data-force-toggle]")) {
      const panel = target.closest<HTMLElement>("[data-deactivation-panel]");
      if (panel) refresh(panel);
      return;
    }
    // Edición: desmarcar "Usuario activo" (estaba activo) muestra el panel y consulta el último contacto.
    if (target.name === "active" && target.dataset.initialActive === "1") {
      const form = target.closest("form");
      const panel = form?.querySelector<HTMLElement>("[data-deactivation-panel]");
      if (!form || !panel) return;
      const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (target.checked) {
        panel.classList.add("hidden");
        panel.dataset.blocked = "0";
        const toggle = panel.querySelector<HTMLInputElement>("[data-force-toggle]");
        if (toggle) toggle.checked = false;
        const confirm = panel.querySelector<HTMLInputElement>("[data-retire-confirm]");
        if (confirm) { confirm.checked = false; confirm.disabled = true; confirm.required = false; }
        const reason = panel.querySelector<HTMLInputElement>("[data-force-reason]");
        if (reason) { reason.disabled = true; reason.required = false; reason.value = ""; }
        panel.querySelector("[data-force-wrap]")?.classList.add("hidden");
        if (submit) submit.disabled = false;
      } else {
        panel.classList.remove("hidden");
        void load(panel);
      }
    }
  });
</script>
