---
import AdminSearch from "../../components/AdminSearch.astro";
import DestructiveAction from "../../components/DestructiveAction.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createSupabaseAdminClient, createSupabaseServerClient } from "../../lib/supabase/server";
import { roleLabels, type AppRole } from "../../lib/types";
const auth = Astro.locals.auth!;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const [{ data: profilesData }, { data: machinesData }, { data: assignmentsData }] = await Promise.all([
  supabase.from("profiles").select("id, full_name, role, job_title, active").is("removed_at", null).order("full_name"),
  supabase.from("machines").select("id, code, name, active").eq("active", true).order("code").order("name"),
  supabase.from("operator_machine_assignments").select("operator_id, machine_id, active"),
]);
let authUsers: any[] = [];
let configurationError = "";
try {
  const admin = createSupabaseAdminClient();
  const { data, error } = await admin.auth.admin.listUsers({ page: 1, perPage: 100 });
  if (error) throw error;
  authUsers = data.users;
} catch (error) {
  configurationError = error instanceof Error ? error.message : "No fue posible consultar usuarios Auth.";
}
const profiles = (profilesData ?? []) as any[];
const machines = (machinesData ?? []) as any[];
const assignments = (assignmentsData ?? []) as any[];
const emailById = new Map(authUsers.map((user) => [user.id, user.email]));
const error = Astro.url.searchParams.get("error") ?? configurationError;
const ok = Astro.url.searchParams.get("ok");
---

<BaseLayout title="Usuarios" description="Administración de usuarios y asignaciones" profile={auth.profile}>
  <main class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6" data-search-scope>
    <header><a class="text-sm font-semibold text-emerald-700" href="/administracion">← Administración</a><div class="mt-2 flex flex-wrap items-end justify-between gap-4"><h1 class="text-3xl font-bold">Usuarios y asignaciones</h1><details><summary class="button-primary cursor-pointer list-none">Nuevo</summary><form class="panel mt-3 grid min-w-[min(92vw,780px)] gap-4 md:grid-cols-[1fr_1fr_200px_auto] md:items-end" method="POST" action="/api/admin/users/invite"><label><span class="field-label">Nombre completo</span><input class="field-control" name="full_name" required /></label><label><span class="field-label">Correo</span><input class="field-control" type="email" name="email" required /></label><label><span class="field-label">Rol</span><select class="field-control" name="role"><option value="OPERATOR">Operario</option><option value="VIEWER">Consulta</option><option value="ADMINISTRATOR">Administrador</option></select></label><button class="button-primary" type="submit">Invitar</button></form></details></div></header>
    {error && <p class="rounded-xl bg-red-50 p-4 text-red-800">{error}</p>}
    {ok && <p class="rounded-xl bg-emerald-50 p-4 text-emerald-800">{ok}</p>}
    <label class="block max-w-lg"><span class="field-label">Buscar</span><input class="field-control" type="search" placeholder="Buscar usuarios" data-search-input /></label>
    <section class="panel overflow-hidden p-0"><div class="overflow-x-auto"><table class="w-full min-w-[1040px] text-left text-sm"><thead class="bg-slate-50 text-slate-600"><tr><th class="p-4">Nombre</th><th class="p-4">Correo</th><th class="p-4">Cargo</th><th class="p-4">Rol</th><th class="p-4">Máquinas</th><th class="p-4">Estado</th><th class="p-4 text-right">Acción</th></tr></thead><tbody>
      {profiles.map((profile) => { const selected = new Set(assignments.filter((item) => item.operator_id === profile.id && item.active).map((item) => item.machine_id)); const assigned = machines.filter((machine) => selected.has(machine.id)); const email = emailById.get(profile.id) ?? "No disponible"; return <tr class="border-t align-top" data-search-row data-search-text={`${profile.full_name} ${email} ${profile.job_title ?? ""} ${roleLabels[profile.role as AppRole]} ${assigned.map((machine) => `${machine.code} ${machine.name}`).join(" ")}`}><td class="p-4 font-semibold">{profile.full_name}</td><td class="p-4">{email}</td><td class="p-4">{profile.job_title || "—"}</td><td class="p-4">{roleLabels[profile.role as AppRole]}</td><td class="p-4">{assigned.length ? assigned.map((machine) => machine.code).join(", ") : "—"}</td><td class="p-4"><span class={`rounded-full px-3 py-1 font-semibold ${profile.active ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-600"}`}>{profile.active ? "Activo" : "Inactivo"}</span></td><td class="p-4 text-right"><div class="flex flex-wrap items-center justify-end gap-2"><details class="inline-block text-left"><summary class="inline-flex min-h-9 cursor-pointer list-none items-center rounded-lg px-2 py-1 text-sm font-bold text-emerald-700 hover:bg-emerald-50 [&::-webkit-details-marker]:hidden">Editar</summary><form class="mt-3 min-w-[min(88vw,780px)] rounded-xl border bg-white p-4" method="POST" action={`/api/admin/users/${profile.id}`}><div class="grid gap-3 sm:grid-cols-2"><label><span class="field-label">Nombre</span><input class="field-control" name="full_name" value={profile.full_name} required /></label><label><span class="field-label">Correo</span><input class="field-control" value={email} disabled /></label><label><span class="field-label">Cargo</span><input class="field-control" name="job_title" value={profile.job_title ?? ""} /></label><label><span class="field-label">Rol</span><select class="field-control" name="role">{(Object.keys(roleLabels) as AppRole[]).map((role) => <option value={role} selected={role === profile.role}>{roleLabels[role]}</option>)}</select></label></div><fieldset class="mt-4"><legend class="field-label">Máquinas asignadas</legend><div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">{machines.map((machine) => <label class="flex min-h-12 items-center gap-3 rounded-xl border p-3"><input class="size-5" type="checkbox" name="machine_ids" value={machine.id} checked={selected.has(machine.id)} /><span>{machine.code} · {machine.name}</span></label>)}</div></fieldset><div class="mt-4 flex flex-wrap items-center justify-between gap-3"><label class="flex min-h-12 items-center gap-3"><input class="size-5" type="checkbox" name="active" checked={profile.active} /><span class="font-semibold">Usuario activo</span></label><button class="button-secondary" type="submit">Guardar</button></div></form></details>{profile.id !== auth.user.id && <DestructiveAction id={profile.id} action={`/api/admin/users/${profile.id}`} recordName={`${profile.full_name} · ${email}`} title="Retirar usuario" description="Se revocará su acceso, se desactivarán sus asignaciones y desaparecerá de la gestión activa. Su identidad histórica se conservará en los reportes y auditorías." buttonLabel="Retirar" confirmLabel="Retirar usuario" intent="remove" />}</div></td></tr>; })}
      {profiles.length === 0 && <tr><td class="p-8 text-center text-slate-500" colspan="7">No hay usuarios configurados.</td></tr>}
    </tbody></table></div></section>
    <AdminSearch />
  </main>
</BaseLayout>
