---
import AdminSearch from "../../components/AdminSearch.astro";
import AdminRecordModal from "../../components/AdminRecordModal.astro";
import DestructiveAction from "../../components/DestructiveAction.astro";
import PageHeader from "../../components/PageHeader.astro";
import UserReactivateAction from "../../components/UserReactivateAction.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { FieldLabel, Label } from "@/components/ui/label";
import { NativeSelect } from "@/components/ui/native-select";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { createSupabaseAdminClient, createSupabaseServerClient } from "../../lib/supabase/server";
import { readAllPages } from "../../lib/supabase/read-all-pages";
import { roleLabels, type AppRole } from "../../lib/types";
const auth = Astro.locals.auth!;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const [{ data: profilesData, error: profilesError }, { data: machinesData, error: machinesError }, { data: assignmentsData, error: assignmentsError }] = await Promise.all([
  readAllPages((start, end) => supabase.from("profiles").select("id, full_name, role, job_title, active, removed_at, removed_by").order("full_name").order("id").range(start, end)),
  readAllPages((start, end) => supabase.from("machines").select("id, code, name, active").eq("active", true).order("code").order("name").order("id").range(start, end)),
  readAllPages((start, end) => supabase.from("operator_machine_assignments").select("operator_id, machine_id, active").order("operator_id").order("machine_id").range(start, end)),
]);
let authUsers: any[] = [];
let configurationError = "";
try {
  const admin = createSupabaseAdminClient();
  const perPage = 1000;
  for (let page = 1; ; page += 1) {
    const { data, error } = await admin.auth.admin.listUsers({ page, perPage });
    if (error) throw error;
    authUsers.push(...data.users);
    if (data.users.length < perPage) break;
  }
} catch {
  configurationError = "No fue posible consultar los correos de los usuarios.";
}
const profiles = (profilesData ?? []) as any[];
const machines = (machinesData ?? []) as any[];
const assignments = (assignmentsData ?? []) as any[];
const emailById = new Map(authUsers.map((user) => [user.id, user.email]));
const error = configurationError || ((profilesError || machinesError || assignmentsError) ? "No fue posible cargar todos los usuarios y asignaciones." : null);
---

<BaseLayout title="Usuarios" description="Administración de usuarios y asignaciones" profile={auth.profile}>
  <main class="mx-auto w-full max-w-7xl space-y-6 px-4 py-4 sm:px-6 sm:py-6" data-search-scope>
    <PageHeader title="Usuarios y asignaciones" back={{ href: "/administracion", label: "Administración" }}>
      <AdminRecordModal slot="actions" id="create-user" title="Nuevo usuario" action="/api/admin/users/invite" submitLabel="Crear usuario" mode="create" size="large">
        <div class="grid gap-4 md:grid-cols-3">
          <Label><FieldLabel>Nombre completo</FieldLabel><Input name="full_name" required /></Label>
          <Label><FieldLabel>Correo</FieldLabel><Input type="email" inputMode="email" autoComplete="email" name="email" required /></Label>
          <Label><FieldLabel>Rol</FieldLabel><NativeSelect name="role"><option value="OPERATOR">Operario</option><option value="VIEWER">Consulta</option><option value="ADMINISTRATOR">Administrador</option></NativeSelect></Label>
        </div>
      </AdminRecordModal>
    </PageHeader>
    {error && <Alert variant="destructive"><AlertDescription>{error}</AlertDescription></Alert>}
    <Label className="block max-w-lg"><FieldLabel>Buscar</FieldLabel><Input type="search" enterKeyHint="search" placeholder="Buscar usuarios" data-search-input /></Label>
    <Card className="rounded-2xl gap-0 overflow-hidden py-0">
      <Table className="responsive-admin-table responsive-admin-table--wide min-w-[1040px]">
        <TableHeader><TableRow><TableHead>Nombre</TableHead><TableHead>Correo</TableHead><TableHead>Cargo</TableHead><TableHead>Rol</TableHead><TableHead>Máquinas</TableHead><TableHead>Estado</TableHead><TableHead className="text-right">Acción</TableHead></TableRow></TableHeader>
        <TableBody>
          {profiles.map((profile) => {
            const selected = new Set(assignments.filter((item) => item.operator_id === profile.id && item.active).map((item) => item.machine_id));
            const assigned = machines.filter((machine) => selected.has(machine.id));
            const email = emailById.get(profile.id) ?? "No disponible";
            const retired = !profile.active && Boolean(profile.removed_at);
            const status = retired ? "Retirado" : profile.active ? "Activo" : "Inactivo";
            return (
              <TableRow data-search-row data-search-text={`${profile.full_name} ${email} ${profile.job_title ?? ""} ${roleLabels[profile.role as AppRole]} ${status} ${assigned.map((machine) => `${machine.code} ${machine.name}`).join(" ")}`}>
                <TableCell className="font-semibold" data-label="Nombre">{profile.full_name}</TableCell>
                <TableCell data-label="Correo">{email}</TableCell>
                <TableCell data-label="Cargo">{profile.job_title || "—"}</TableCell>
                <TableCell data-label="Rol">{roleLabels[profile.role as AppRole]}</TableCell>
                <TableCell data-label="Máquinas">{assigned.length ? assigned.map((machine) => machine.code).join(", ") : "—"}</TableCell>
                <TableCell data-label="Estado"><Badge variant={profile.active ? "submitted" : retired ? "cancelled" : "neutral"}>{status}</Badge></TableCell>
                <TableCell className="text-right" data-label="Acciones">
                  <div class="flex flex-wrap items-center justify-end gap-2">
                    {retired ? (
                      <UserReactivateAction userId={profile.id} userName={profile.full_name} role={profile.role as AppRole} machines={machines} />
                    ) : (
                      <>
                        <AdminRecordModal id={`edit-user-${profile.id}`} title="Editar usuario" action={`/api/admin/users/${profile.id}`} submitLabel="Guardar cambios" mode="edit" size="large">
                          <div class="grid gap-3 sm:grid-cols-2">
                            <Label><FieldLabel>Nombre</FieldLabel><Input name="full_name" value={profile.full_name} required /></Label>
                            <Label><FieldLabel>Correo</FieldLabel><Input type="email" inputMode="email" autoComplete="email" name="email" value={email} required /></Label>
                            <Label><FieldLabel>Cargo</FieldLabel><Input name="job_title" value={profile.job_title ?? ""} /></Label>
                            <Label><FieldLabel>Rol</FieldLabel><NativeSelect name="role">{(Object.keys(roleLabels) as AppRole[]).map((role) => <option value={role} selected={role === profile.role}>{roleLabels[role]}</option>)}</NativeSelect></Label>
                          </div>
                          <fieldset class="mt-4">
                            <legend class="field-label mb-2 block text-sm font-semibold text-foreground">Máquinas asignadas</legend>
                            <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                              {machines.map((machine) => <Label className="flex min-h-12 items-center gap-3 rounded-xl border bg-card p-3"><input class="size-5 shrink-0 accent-primary" type="checkbox" name="machine_ids" value={machine.id} checked={selected.has(machine.id)} /><span>{machine.code} · {machine.name}</span></Label>)}
                            </div>
                          </fieldset>
                          <Label className="mt-4 flex min-h-12 items-center gap-3"><input class="size-5 accent-primary" type="checkbox" name="active" checked={profile.active} /><span class="font-semibold">Usuario activo</span></Label>
                        </AdminRecordModal>
                        {profile.id !== auth.user.id && <DestructiveAction id={profile.id} action={`/api/admin/users/${profile.id}`} recordName={`${profile.full_name} · ${email}`} title="Retirar usuario" description="Se revocará su acceso, se desactivarán sus asignaciones y desaparecerá de la gestión activa. Su identidad histórica se conservará en los reportes y auditorías." buttonLabel="Retirar" confirmLabel="Retirar usuario" intent="remove" />}
                      </>
                    )}
                  </div>
                </TableCell>
              </TableRow>
            );
          })}
          {profiles.length === 0 && <TableRow><TableCell className="p-8 text-center text-muted-foreground" colSpan={7}>No hay usuarios configurados.</TableCell></TableRow>}
        </TableBody>
      </Table>
    </Card>
    <AdminSearch />
  </main>
</BaseLayout>
