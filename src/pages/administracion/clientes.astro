---
import CatalogAdminPage from "../../components/CatalogAdminPage.astro";
import { createSupabaseServerClient } from "../../lib/supabase/server";
import { readAllPages } from "../../lib/supabase/read-all-pages";
const auth = Astro.locals.auth!;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data, error: readError } = await readAllPages((start, end) => supabase.from("clients").select("id, code, name, active").order("name").order("code").order("id").range(start, end));
---
<CatalogAdminPage profile={auth.profile} title="Clientes frecuentes" description="Valores sugeridos al escribir un Cliente en el reporte." catalog="clients" items={data as any[]} error={Astro.url.searchParams.get("error") ?? (readError ? "No fue posible cargar todos los clientes." : null)} ok={Astro.url.searchParams.get("ok")} />
