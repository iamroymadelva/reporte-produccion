---
import AdminSearch from "../../components/AdminSearch.astro";
import AdminFlashMessage from "../../components/AdminFlashMessage.astro";
import AdminRecordModal from "../../components/AdminRecordModal.astro";
import AdminReactivateAction from "../../components/AdminReactivateAction.astro";
import AdminStatusToggle from "../../components/AdminStatusToggle.astro";
import DestructiveAction from "../../components/DestructiveAction.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createSupabaseServerClient } from "../../lib/supabase/server";
const auth = Astro.locals.auth!;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data } = await supabase.from("machines").select("id, code, name, description, active").order("code").order("name");
const machines = (data ?? []) as any[];
const error = Astro.url.searchParams.get("error");
const ok = Astro.url.searchParams.get("ok");
---

<BaseLayout title="Máquinas" description="Administración de máquinas" profile={auth.profile}>
  <main class="mx-auto max-w-6xl space-y-6 px-4 py-8 sm:px-6" data-search-scope>
    <header><a class="text-sm font-semibold text-emerald-700" href="/administracion">← Administración</a><div class="mt-2 flex flex-wrap items-end justify-between gap-4"><h1 class="text-3xl font-bold">Máquinas</h1><AdminRecordModal id="create-machine" title="Nueva máquina" action="/api/admin/machines" submitLabel="Crear" mode="create"><div class="grid gap-4"><label><span class="field-label">Código</span><input class="field-control" name="code" required /></label><label><span class="field-label">Nombre</span><input class="field-control" name="name" required /></label><label><span class="field-label">Descripción</span><input class="field-control" name="description" /></label></div></AdminRecordModal></div></header>
    <AdminFlashMessage error={error} ok={ok} />
    <label class="block max-w-lg"><span class="field-label">Buscar</span><input class="field-control" type="search" enterkeyhint="search" placeholder="Buscar máquinas" data-search-input /></label>
    <section class="panel overflow-hidden p-0"><div class="overflow-x-auto"><table class="responsive-admin-table w-full min-w-[760px] text-left text-sm"><thead class="bg-slate-50 text-slate-600"><tr><th class="p-4">Código</th><th class="p-4">Nombre</th><th class="p-4">Descripción</th><th class="p-4">Estado</th><th class="p-4 text-right">Acción</th></tr></thead><tbody>
      {machines.map((machine) => <tr class="border-t align-top" data-search-row data-search-text={`${machine.code} ${machine.name} ${machine.description ?? ""}`}><td class="p-4 font-semibold" data-label="Código">{machine.code}</td><td class="p-4" data-label="Nombre">{machine.name}</td><td class="p-4 text-slate-600" data-label="Descripción">{machine.description || "—"}</td><td class="p-4" data-label="Estado"><AdminStatusToggle id={machine.id} action="/api/admin/machines" active={machine.active}><input type="hidden" name="code" value={machine.code} /><input type="hidden" name="name" value={machine.name} /><input type="hidden" name="description" value={machine.description ?? ""} /></AdminStatusToggle></td><td class="p-4 text-right" data-label="Acciones"><div class="flex flex-wrap items-center justify-end gap-2"><AdminRecordModal id={`edit-machine-${machine.id}`} title={`Editar: ${machine.name}`} action="/api/admin/machines" submitLabel="Guardar" mode="edit" recordId={machine.id}><div class="grid gap-4"><label><span class="field-label">Código</span><input class="field-control" name="code" value={machine.code} required /></label><label><span class="field-label">Nombre</span><input class="field-control" name="name" value={machine.name} required /></label><label><span class="field-label">Descripción</span><input class="field-control" name="description" value={machine.description ?? ""} /></label><label class="flex min-h-12 items-center gap-2"><input class="size-5" type="checkbox" name="active" checked={machine.active} /><span class="font-semibold">Activa</span></label></div></AdminRecordModal>{!machine.active && <AdminReactivateAction id={machine.id} action="/api/admin/machines" />}<DestructiveAction id={machine.id} action="/api/admin/machines" recordName={`${machine.code} · ${machine.name}`} /></div></td></tr>)}
      {machines.length === 0 && <tr><td class="p-8 text-center text-slate-500" colspan="5">No hay máquinas configuradas.</td></tr>}
    </tbody></table></div></section>
    <AdminSearch />
  </main>
</BaseLayout>
