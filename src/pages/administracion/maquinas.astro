---
import AdminSearch from "../../components/AdminSearch.astro";
import AdminRecordModal from "../../components/AdminRecordModal.astro";
import AdminReactivateAction from "../../components/AdminReactivateAction.astro";
import AdminStatusToggle from "../../components/AdminStatusToggle.astro";
import DestructiveAction from "../../components/DestructiveAction.astro";
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { FieldLabel, Label } from "@/components/ui/label";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { createSupabaseServerClient } from "../../lib/supabase/server";
import { readAllPages } from "../../lib/supabase/read-all-pages";
const auth = Astro.locals.auth!;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data, error: readError } = await readAllPages((start, end) => supabase.from("machines").select("id, code, name, description, active").order("code").order("name").order("id").range(start, end));
const machines = (data ?? []) as any[];
const error = readError ? "No fue posible cargar todas las máquinas." : null;
---

<BaseLayout title="Máquinas" description="Administración de máquinas" profile={auth.profile}>
  <main class="mx-auto w-full max-w-7xl space-y-6 px-4 py-4 sm:px-6 sm:py-6" data-search-scope>
    <PageHeader title="Máquinas" back={{ href: "/administracion", label: "Administración" }}>
      <AdminRecordModal slot="actions" id="create-machine" title="Nueva máquina" action="/api/admin/machines" submitLabel="Crear" mode="create">
        <div class="grid gap-4">
          <Label><FieldLabel>Código</FieldLabel><Input name="code" required /></Label>
          <Label><FieldLabel>Nombre</FieldLabel><Input name="name" required /></Label>
          <Label><FieldLabel>Descripción</FieldLabel><Input name="description" /></Label>
        </div>
      </AdminRecordModal>
    </PageHeader>
    {error && <Alert variant="destructive"><AlertDescription>{error}</AlertDescription></Alert>}
    <Label className="block max-w-lg"><FieldLabel>Buscar</FieldLabel><Input type="search" enterKeyHint="search" placeholder="Buscar máquinas" data-search-input /></Label>
    <Card className="rounded-2xl gap-0 overflow-hidden py-0">
      <Table className="responsive-admin-table min-w-[760px]">
        <TableHeader><TableRow><TableHead>Código</TableHead><TableHead>Nombre</TableHead><TableHead>Descripción</TableHead><TableHead>Estado</TableHead><TableHead className="text-right">Acción</TableHead></TableRow></TableHeader>
        <TableBody>
          {machines.map((machine) => (
            <TableRow data-search-row data-search-text={`${machine.code} ${machine.name} ${machine.description ?? ""}`}>
              <TableCell className="font-semibold" data-label="Código">{machine.code}</TableCell>
              <TableCell data-label="Nombre">{machine.name}</TableCell>
              <TableCell className="text-muted-foreground" data-label="Descripción">{machine.description || "—"}</TableCell>
              <TableCell data-label="Estado">
                <AdminStatusToggle id={machine.id} action="/api/admin/machines" active={machine.active}>
                  <input type="hidden" name="code" value={machine.code} /><input type="hidden" name="name" value={machine.name} /><input type="hidden" name="description" value={machine.description ?? ""} />
                </AdminStatusToggle>
              </TableCell>
              <TableCell className="text-right" data-label="Acciones">
                <div class="flex flex-wrap items-center justify-end gap-2">
                  <AdminRecordModal id={`edit-machine-${machine.id}`} title={`Editar: ${machine.name}`} action="/api/admin/machines" submitLabel="Guardar" mode="edit" recordId={machine.id}>
                    <div class="grid gap-4">
                      <Label><FieldLabel>Código</FieldLabel><Input name="code" value={machine.code} required /></Label>
                      <Label><FieldLabel>Nombre</FieldLabel><Input name="name" value={machine.name} required /></Label>
                      <Label><FieldLabel>Descripción</FieldLabel><Input name="description" value={machine.description ?? ""} /></Label>
                      <Label className="flex min-h-12 items-center gap-2"><input class="size-5 accent-primary" type="checkbox" name="active" checked={machine.active} /><span class="font-semibold">Activa</span></Label>
                    </div>
                  </AdminRecordModal>
                  {!machine.active && <AdminReactivateAction id={machine.id} action="/api/admin/machines" />}
                  <DestructiveAction id={machine.id} action="/api/admin/machines" recordName={`${machine.code} · ${machine.name}`} />
                </div>
              </TableCell>
            </TableRow>
          ))}
          {machines.length === 0 && <TableRow><TableCell className="p-8 text-center text-muted-foreground" colSpan={5}>No hay máquinas configuradas.</TableCell></TableRow>}
        </TableBody>
      </Table>
    </Card>
    <AdminSearch />
  </main>
</BaseLayout>
