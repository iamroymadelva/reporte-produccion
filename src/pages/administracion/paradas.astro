---
import AdminSearch from "../../components/AdminSearch.astro";
import AdminRecordModal from "../../components/AdminRecordModal.astro";
import AdminReactivateAction from "../../components/AdminReactivateAction.astro";
import AdminStatusToggle from "../../components/AdminStatusToggle.astro";
import DestructiveAction from "../../components/DestructiveAction.astro";
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { FieldLabel, Label } from "@/components/ui/label";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Textarea } from "@/components/ui/textarea";
import { createSupabaseServerClient } from "../../lib/supabase/server";
import { readAllPages } from "../../lib/supabase/read-all-pages";
const auth = Astro.locals.auth!;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data, error: readError } = await readAllPages((start, end) => supabase.from("stop_categories").select("id, code, name, description, active, numeric_code").order("numeric_code").order("code").order("id").range(start, end));
const categories = (data ?? []) as any[];
const error = readError ? "No fue posible cargar todas las categorías." : null;
const preview = (value: string) => value.length > 90 ? `${value.slice(0, 90).trim()}…` : value;
---

<BaseLayout title="Categorías de parada" description="Administración de categorías de parada" profile={auth.profile}>
  <main class="mx-auto w-full max-w-7xl space-y-6 px-4 py-4 sm:px-6 sm:py-6" data-search-scope>
    <PageHeader title="Categorías de parada" back={{ href: "/administracion", label: "Administración" }}>
      <AdminRecordModal slot="actions" id="create-stop-category" title="Nueva categoría de parada" action="/api/admin/stop-categories" submitLabel="Crear" mode="create">
        <div class="grid gap-4">
          <Label><FieldLabel>Código</FieldLabel><Input inputMode="numeric" name="code" required /></Label>
          <Label><FieldLabel>Categoría</FieldLabel><Input name="name" required /></Label>
          <Label><FieldLabel>Descripción</FieldLabel><Textarea name="description"></Textarea></Label>
        </div>
      </AdminRecordModal>
    </PageHeader>
    {error && <Alert variant="destructive"><AlertDescription>{error}</AlertDescription></Alert>}
    <Label className="block max-w-lg"><FieldLabel>Buscar</FieldLabel><Input type="search" enterKeyHint="search" placeholder="Buscar categorías" data-search-input /></Label>
    <Card className="rounded-2xl gap-0 overflow-hidden py-0">
      <Table className="responsive-admin-table min-w-[880px]">
        <TableHeader><TableRow><TableHead>Código</TableHead><TableHead>Categoría</TableHead><TableHead>Descripción</TableHead><TableHead>Estado</TableHead><TableHead className="text-right">Acción</TableHead></TableRow></TableHeader>
        <TableBody>
          {categories.map((category) => {
            const description = category.description ?? "";
            return (
              <TableRow data-search-row data-search-text={`${category.code} ${category.name} ${description}`}>
                <TableCell className="font-bold" data-label="Código">{category.code}</TableCell>
                <TableCell className="font-semibold" data-label="Categoría">{category.name}</TableCell>
                <TableCell className="max-w-md text-muted-foreground" data-label="Descripción">
                  {description ? description.length > 90 ? (
                    <details><summary class="cursor-pointer text-primary"><span class="text-muted-foreground">{preview(description)}</span> Ver más</summary><p class="mt-2 whitespace-pre-wrap text-foreground">{description}</p></details>
                  ) : description : "—"}
                </TableCell>
                <TableCell data-label="Estado">
                  <AdminStatusToggle id={category.id} action="/api/admin/stop-categories" active={category.active}>
                    <input type="hidden" name="code" value={category.code} /><input type="hidden" name="name" value={category.name} /><input type="hidden" name="description" value={description} />
                  </AdminStatusToggle>
                </TableCell>
                <TableCell className="text-right" data-label="Acciones">
                  <div class="flex flex-wrap items-center justify-end gap-2">
                    <AdminRecordModal id={`edit-stop-category-${category.id}`} title={`Editar: ${category.name}`} action="/api/admin/stop-categories" submitLabel="Guardar" mode="edit" recordId={category.id}>
                      <div class="grid gap-4">
                        <Label><FieldLabel>Código</FieldLabel><Input inputMode="numeric" name="code" value={category.code} required /></Label>
                        <Label><FieldLabel>Categoría</FieldLabel><Input name="name" value={category.name} required /></Label>
                        <Label><FieldLabel>Descripción</FieldLabel><Textarea name="description">{description}</Textarea></Label>
                        <Label className="flex min-h-12 items-center gap-2"><input class="size-5 accent-primary" type="checkbox" name="active" checked={category.active} /><span class="font-semibold">Activa</span></Label>
                      </div>
                    </AdminRecordModal>
                    {!category.active && <AdminReactivateAction id={category.id} action="/api/admin/stop-categories" />}
                    <DestructiveAction id={category.id} action="/api/admin/stop-categories" recordName={`${category.code} · ${category.name}`} />
                  </div>
                </TableCell>
              </TableRow>
            );
          })}
          {categories.length === 0 && <TableRow><TableCell className="p-8 text-center text-muted-foreground" colSpan={5}>No hay categorías configuradas.</TableCell></TableRow>}
        </TableBody>
      </Table>
    </Card>
    <AdminSearch />
  </main>
</BaseLayout>
