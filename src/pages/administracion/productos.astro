---
import CatalogAdminPage from "../../components/CatalogAdminPage.astro";
import { createSupabaseServerClient } from "../../lib/supabase/server";
const auth = Astro.locals.auth!;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data } = await supabase.from("products").select("id, code, name, active").order("name").order("code");
---
<CatalogAdminPage profile={auth.profile} title="Productos frecuentes" description="Valores sugeridos al escribir un Producto en el reporte." catalog="products" items={(data ?? []) as any[]} error={Astro.url.searchParams.get("error")} ok={Astro.url.searchParams.get("ok")} />
