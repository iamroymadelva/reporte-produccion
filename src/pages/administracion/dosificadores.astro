---
import CatalogAdminPage from "../../components/CatalogAdminPage.astro";
import { createSupabaseServerClient } from "../../lib/supabase/server";
const auth = Astro.locals.auth!;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data } = await supabase.from("dosifier_types").select("id, code, name, active").order("name").order("code");
---
<CatalogAdminPage profile={auth.profile} title="Tipos de dosificador" description="Tipos de dosificador disponibles en los reportes." catalog="dosifier_types" items={(data ?? []) as any[]} error={Astro.url.searchParams.get("error")} ok={Astro.url.searchParams.get("ok")} />
