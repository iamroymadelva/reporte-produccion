---
import AdminSearch from "../../components/AdminSearch.astro";
import DestructiveAction from "../../components/DestructiveAction.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createSupabaseServerClient } from "../../lib/supabase/server";
const auth = Astro.locals.auth!;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data } = await supabase.from("shifts").select("id, name, start_time, end_time, active").order("start_time").order("end_time");
const shifts = (data ?? []) as any[];
const error = Astro.url.searchParams.get("error");
const ok = Astro.url.searchParams.get("ok");
const shortTime = (value: string) => value.slice(0, 5);
const label = (shift: any) => shift.name ? `${shift.name} · ${shortTime(shift.start_time)} - ${shortTime(shift.end_time)}` : `${shortTime(shift.start_time)} - ${shortTime(shift.end_time)}`;
---

<BaseLayout title="Turnos" description="Administración de turnos" profile={auth.profile}>
  <main class="mx-auto max-w-6xl space-y-6 px-4 py-8 sm:px-6" data-search-scope>
    <header><a class="text-sm font-semibold text-emerald-700" href="/administracion">← Administración</a><div class="mt-2 flex flex-wrap items-end justify-between gap-4"><div><h1 class="text-3xl font-bold">Turnos</h1><p class="mt-2 text-slate-600">Los rangos pueden cruzar medianoche.</p></div><details><summary class="button-primary cursor-pointer list-none">Nuevo</summary><form class="panel mt-3 grid min-w-[min(90vw,680px)] gap-4 md:grid-cols-[1fr_150px_150px_auto] md:items-end" method="POST" action="/api/admin/shifts"><label><span class="field-label">Nombre</span><input class="field-control" name="name" /></label><label><span class="field-label">Hora de inicio *</span><input class="field-control" type="time" name="start_time" required /></label><label><span class="field-label">Hora de finalización *</span><input class="field-control" type="time" name="end_time" required /></label><button class="button-primary" type="submit">Crear</button></form></details></div></header>
    {error && <p class="rounded-xl bg-red-50 p-4 text-red-800">{error}</p>}
    {ok && <p class="rounded-xl bg-emerald-50 p-4 text-emerald-800">{ok}</p>}
    <label class="block max-w-lg"><span class="field-label">Buscar</span><input class="field-control" type="search" placeholder="Buscar turnos" data-search-input /></label>
    <section class="panel overflow-hidden p-0"><div class="overflow-x-auto"><table class="w-full min-w-[720px] text-left text-sm"><thead class="bg-slate-50 text-slate-600"><tr><th class="p-4">Turno</th><th class="p-4">Hora de inicio</th><th class="p-4">Hora de finalización</th><th class="p-4">Estado</th><th class="p-4 text-right">Acción</th></tr></thead><tbody>
      {shifts.map((shift) => <tr class="border-t align-top" data-search-row data-search-text={`${label(shift)} ${shift.active ? "activo" : "inactivo"}`}><td class="p-4 font-semibold">{label(shift)}</td><td class="p-4">{shortTime(shift.start_time)}</td><td class="p-4">{shortTime(shift.end_time)}</td><td class="p-4"><span class={`rounded-full px-3 py-1 font-semibold ${shift.active ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-600"}`}>{shift.active ? "Activo" : "Inactivo"}</span></td><td class="p-4 text-right"><div class="flex flex-wrap items-center justify-end gap-2"><details class="inline-block text-left"><summary class="inline-flex min-h-9 cursor-pointer list-none items-center rounded-lg px-2 py-1 text-sm font-bold text-emerald-700 hover:bg-emerald-50 [&::-webkit-details-marker]:hidden">Editar</summary><form class="mt-3 grid min-w-[min(82vw,600px)] gap-3 rounded-xl border bg-white p-4 sm:grid-cols-2" method="POST" action="/api/admin/shifts"><input type="hidden" name="id" value={shift.id} /><label class="sm:col-span-2"><span class="field-label">Nombre</span><input class="field-control" name="name" value={shift.name ?? ""} placeholder={label(shift)} /></label><label><span class="field-label">Hora de inicio *</span><input class="field-control" type="time" name="start_time" value={shortTime(shift.start_time)} required /></label><label><span class="field-label">Hora de finalización *</span><input class="field-control" type="time" name="end_time" value={shortTime(shift.end_time)} required /></label><label class="flex min-h-12 items-center gap-2"><input class="size-5" type="checkbox" name="active" checked={shift.active} /><span class="font-semibold">Activo</span></label><button class="button-secondary" type="submit">Guardar</button></form></details><DestructiveAction id={shift.id} action="/api/admin/shifts" recordName={label(shift)} /></div></td></tr>)}
      {shifts.length === 0 && <tr><td class="p-8 text-center text-slate-500" colspan="5">No hay turnos configurados.</td></tr>}
    </tbody></table></div></section>
    <AdminSearch />
  </main>
</BaseLayout>
