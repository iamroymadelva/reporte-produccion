---
import AdminSearch from "../../components/AdminSearch.astro";
import AdminRecordModal from "../../components/AdminRecordModal.astro";
import AdminReactivateAction from "../../components/AdminReactivateAction.astro";
import AdminStatusToggle from "../../components/AdminStatusToggle.astro";
import DestructiveAction from "../../components/DestructiveAction.astro";
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { FieldLabel, Label } from "@/components/ui/label";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { createSupabaseServerClient } from "../../lib/supabase/server";
import { readAllPages } from "../../lib/supabase/read-all-pages";
const auth = Astro.locals.auth!;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data, error: readError } = await readAllPages((start, end) => supabase.from("shifts").select("id, name, start_time, end_time, active").order("start_time").order("end_time").order("id").range(start, end));
const shifts = (data ?? []) as any[];
const error = readError ? "No fue posible cargar todos los turnos." : null;
const shortTime = (value: string) => value.slice(0, 5);
const label = (shift: any) => shift.name ? `${shift.name} · ${shortTime(shift.start_time)} - ${shortTime(shift.end_time)}` : `${shortTime(shift.start_time)} - ${shortTime(shift.end_time)}`;
---

<BaseLayout title="Turnos" description="Administración de turnos" profile={auth.profile}>
  <main class="mx-auto max-w-6xl space-y-6 px-4 py-8 sm:px-6" data-search-scope>
    <PageHeader title="Turnos" description="Los rangos pueden cruzar medianoche." back={{ href: "/administracion", label: "Administración" }}>
      <AdminRecordModal slot="actions" id="create-shift" title="Nuevo turno" action="/api/admin/shifts" submitLabel="Crear" mode="create">
        <div class="grid gap-4">
          <Label><FieldLabel>Nombre</FieldLabel><Input name="name" /></Label>
          <Label><FieldLabel>Hora de inicio *</FieldLabel><Input type="time" name="start_time" required /></Label>
          <Label><FieldLabel>Hora de finalización *</FieldLabel><Input type="time" name="end_time" required /></Label>
        </div>
      </AdminRecordModal>
    </PageHeader>
    {error && <Alert variant="destructive"><AlertDescription>{error}</AlertDescription></Alert>}
    <Label className="block max-w-lg"><FieldLabel>Buscar</FieldLabel><Input type="search" enterKeyHint="search" placeholder="Buscar turnos" data-search-input /></Label>
    <Card className="gap-0 overflow-hidden py-0">
      <Table className="responsive-admin-table min-w-[720px]">
        <TableHeader><TableRow><TableHead>Turno</TableHead><TableHead>Hora de inicio</TableHead><TableHead>Hora de finalización</TableHead><TableHead>Estado</TableHead><TableHead className="text-right">Acción</TableHead></TableRow></TableHeader>
        <TableBody>
          {shifts.map((shift) => (
            <TableRow data-search-row data-search-text={`${label(shift)} ${shift.active ? "activo" : "inactivo"}`}>
              <TableCell className="font-semibold" data-label="Turno">{label(shift)}</TableCell>
              <TableCell data-label="Inicio">{shortTime(shift.start_time)}</TableCell>
              <TableCell data-label="Final">{shortTime(shift.end_time)}</TableCell>
              <TableCell data-label="Estado">
                <AdminStatusToggle id={shift.id} action="/api/admin/shifts" active={shift.active}>
                  <input type="hidden" name="name" value={shift.name ?? ""} /><input type="hidden" name="start_time" value={shortTime(shift.start_time)} /><input type="hidden" name="end_time" value={shortTime(shift.end_time)} />
                </AdminStatusToggle>
              </TableCell>
              <TableCell className="text-right" data-label="Acciones">
                <div class="flex flex-wrap items-center justify-end gap-2">
                  <AdminRecordModal id={`edit-shift-${shift.id}`} title={`Editar: ${label(shift)}`} action="/api/admin/shifts" submitLabel="Guardar" mode="edit" recordId={shift.id}>
                    <div class="grid gap-4">
                      <Label><FieldLabel>Nombre</FieldLabel><Input name="name" value={shift.name ?? ""} placeholder={label(shift)} /></Label>
                      <Label><FieldLabel>Hora de inicio *</FieldLabel><Input type="time" name="start_time" value={shortTime(shift.start_time)} required /></Label>
                      <Label><FieldLabel>Hora de finalización *</FieldLabel><Input type="time" name="end_time" value={shortTime(shift.end_time)} required /></Label>
                      <Label className="flex min-h-12 items-center gap-2"><input class="size-5 accent-primary" type="checkbox" name="active" checked={shift.active} /><span class="font-semibold">Activo</span></Label>
                    </div>
                  </AdminRecordModal>
                  {!shift.active && <AdminReactivateAction id={shift.id} action="/api/admin/shifts" />}
                  <DestructiveAction id={shift.id} action="/api/admin/shifts" recordName={label(shift)} />
                </div>
              </TableCell>
            </TableRow>
          ))}
          {shifts.length === 0 && <TableRow><TableCell className="p-8 text-center text-muted-foreground" colSpan={5}>No hay turnos configurados.</TableCell></TableRow>}
        </TableBody>
      </Table>
    </Card>
    <AdminSearch />
  </main>
</BaseLayout>
