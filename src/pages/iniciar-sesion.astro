---
import BaseLayout from "../layouts/BaseLayout.astro";

if (Astro.locals.auth) return Astro.redirect("/");
const error = Astro.url.searchParams.get("error");
const ok = Astro.url.searchParams.get("ok");
---

<BaseLayout title="Iniciar sesión" description="Acceso al reporte diario de producción y mantenimiento">
  <main class="grid min-h-dvh place-items-center px-4 py-6 sm:px-5 sm:py-12">
    <section class="panel w-full max-w-md p-5 sm:p-9">
      <p class="text-sm font-bold uppercase tracking-wider text-emerald-700">Acceso seguro</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight">Reporte de Producción</h1>
      <p class="mt-3 text-slate-600">Ingresa con la cuenta asignada por Administración.</p>
      {error && <p class="mt-5 rounded-xl bg-red-50 p-4 text-sm font-medium text-red-800">{error}</p>}
      {ok && <p class="mt-5 rounded-xl bg-emerald-50 p-4 text-sm font-medium text-emerald-800">{ok}</p>}
      <form class="mt-7 space-y-5" method="POST" action="/api/auth/login">
        <label>
          <span class="field-label">Correo electrónico</span>
          <input class="field-control" type="email" inputmode="email" name="email" autocomplete="email" required />
        </label>
        <div>
          <label class="field-label" for="login-password">Contraseña</label>
          <div class="relative">
            <input id="login-password" class="field-control pr-14" type="password" name="password" autocomplete="current-password" required />
            <button
              id="toggle-password-visibility"
              class="absolute right-0 top-1/2 flex size-11 -translate-y-1/2 items-center justify-center rounded-xl text-slate-500 transition hover:text-emerald-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-emerald-600"
              type="button"
              aria-label="Mostrar contraseña"
              aria-controls="login-password"
              aria-pressed="false"
              title="Mostrar contraseña"
            >
              <svg data-password-hidden-icon class="pointer-events-none size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12S5.75 6 12 6s9.75 6 9.75 6S18.25 18 12 18 2.25 12 2.25 12Z" />
                <circle cx="12" cy="12" r="2.5" />
              </svg>
              <svg data-password-visible-icon class="pointer-events-none hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 4.25A10.8 10.8 0 0 1 12 4c6.25 0 9.75 8 9.75 8a17.6 17.6 0 0 1-2.1 3.15M6.6 6.6C3.85 8.5 2.25 12 2.25 12S5.75 20 12 20a9.9 9.9 0 0 0 4.2-.95" />
              </svg>
            </button>
          </div>
        </div>
        <button class="button-primary w-full" type="submit">Iniciar sesión</button>
      </form>
      <a class="mt-5 block text-center text-sm font-semibold text-emerald-700 hover:underline" href="/recuperar-contrasena">¿Olvidaste tu contraseña?</a>
      <p class="mt-6 text-center text-sm text-slate-500">No hay registro público de usuarios.</p>
    </section>
  </main>
</BaseLayout>

<script>
  const passwordField = document.querySelector<HTMLInputElement>("#login-password");
  const visibilityToggle = document.querySelector<HTMLButtonElement>("#toggle-password-visibility");
  const hiddenIcon = visibilityToggle?.querySelector<SVGElement>("[data-password-hidden-icon]");
  const visibleIcon = visibilityToggle?.querySelector<SVGElement>("[data-password-visible-icon]");

  visibilityToggle?.addEventListener("click", () => {
    if (!passwordField || !visibilityToggle) return;
    const willShowPassword = passwordField.type === "password";
    const accessibleLabel = willShowPassword ? "Ocultar contraseña" : "Mostrar contraseña";

    passwordField.type = willShowPassword ? "text" : "password";
    visibilityToggle.setAttribute("aria-label", accessibleLabel);
    visibilityToggle.setAttribute("aria-pressed", String(willShowPassword));
    visibilityToggle.title = accessibleLabel;
    hiddenIcon?.classList.toggle("hidden", willShowPassword);
    visibleIcon?.classList.toggle("hidden", !willShowPassword);
  });
</script>
