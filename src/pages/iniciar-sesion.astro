---
import BaseLayout from "../layouts/BaseLayout.astro";
import LoginCard from "../components/LoginCard.astro";

// `?reauth=1`: el usuario ya tiene sesión pero debe iniciar sesión de nuevo en línea para subir datos capturados sin
// conexión (FR-006b). Sin ese parámetro, quien ya inició sesión va al inicio.
const reauth = Astro.url.searchParams.get("reauth") === "1";
if (Astro.locals.auth && !reauth) return Astro.redirect("/");
const error = Astro.url.searchParams.get("error");
const ok = Astro.url.searchParams.get("ok");
const notice = reauth ? "Inicia sesión de nuevo, con conexión, con tu usuario y contraseña para poder subir los datos que capturaste sin conexión. No se perdió nada." : null;
---

<BaseLayout title="Iniciar sesión" description="Acceso al reporte diario de producción y mantenimiento">
  <LoginCard error={error} ok={ok} notice={notice} />
</BaseLayout>
