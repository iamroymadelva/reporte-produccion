---
import { Badge, badgeVariants } from "@/components/ui/badge";

interface Props {
  id: string;
  action: string;
  active: boolean;
}

const { id, action, active } = Astro.props;
---

{active ? (
  <form class="inline" method="POST" action={action}>
    <input type="hidden" name="id" value={id} />
    <slot />
    <button
      class={badgeVariants({ variant: "submitted", className: "min-h-11 cursor-pointer px-3 text-sm outline-none hover:bg-success/25 focus-visible:ring-[3px] focus-visible:ring-ring/50" })}
      type="submit"
      title="Desactivar"
      aria-label="Desactivar"
    >
      Activo
    </button>
  </form>
) : (
  <Badge variant="neutral" className="min-h-11 px-3 text-sm">Inactivo</Badge>
)}
