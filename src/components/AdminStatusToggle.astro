---
interface Props {
  id: string;
  action: string;
  active: boolean;
}

const { id, action, active } = Astro.props;
---

{active ? (
  <form class="inline" method="POST" action={action}>
    <input type="hidden" name="id" value={id} />
    <slot />
    <button
      class="inline-flex min-h-9 items-center rounded-full bg-emerald-100 px-3 py-1 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2"
      type="submit"
      title="Desactivar"
      aria-label="Desactivar"
    >
      Activo
    </button>
  </form>
) : (
  <span class="inline-flex min-h-9 items-center rounded-full bg-slate-200 px-3 py-1 text-sm font-semibold text-slate-700">Inactivo</span>
)}
