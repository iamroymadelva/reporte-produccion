---
import { KeyRound, X } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import PasswordField from "./PasswordField";
import { MIN_PASSWORD_LENGTH } from "../lib/user-admin";

interface Props {
  userId: string;
  userName: string;
  username: string;
}

const { userId, userName, username } = Astro.props;
const dialogId = `reset-password-${userId.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
---

<button class={buttonVariants({ variant: "ghost", className: "min-w-11 px-3 text-primary hover:text-primary" })} type="button" title="Restablecer contraseña" aria-label="Restablecer contraseña" data-modal-open={dialogId}>
  <KeyRound className="pointer-events-none size-5" aria-hidden="true" />
  <span class="admin-action-text">Restablecer contraseña</span>
</button>

<template id={dialogId} data-admin-dialog-template data-dialog-title="Restablecer contraseña" data-dialog-description="Define una nueva contraseña para el usuario.">
  <form class="grid max-h-[calc(100dvh-1rem)] w-full min-w-0 grid-rows-[auto_minmax(0,1fr)_auto] sm:max-h-[calc(100dvh-2rem)]" method="POST" action={`/api/admin/users/${userId}`}>
    <input type="hidden" name="intent" value="reset_password" />
    <header class="flex items-center justify-between gap-3 border-b px-5 py-4">
      <h2 id={`${dialogId}-title`} class="text-xl font-bold text-foreground">Restablecer contraseña</h2>
      <button class={buttonVariants({ variant: "ghost", size: "icon-touch" })} type="button" title="Cerrar" aria-label="Cerrar" data-modal-close>
        <X className="size-5" aria-hidden="true" />
      </button>
    </header>
    <div class="min-h-0 overflow-y-auto p-5">
      <p class="mb-4 text-foreground">Usuario: <strong>{userName}</strong> <span class="text-muted-foreground">({username})</span></p>
      <div class="grid gap-4">
        <PasswordField id={`${dialogId}-password`} label="Nueva contraseña" name="password" minLength={MIN_PASSWORD_LENGTH} />
        <PasswordField id={`${dialogId}-password-confirm`} label="Confirmar contraseña" name="password_confirm" minLength={MIN_PASSWORD_LENGTH} />
        <p class="text-sm text-muted-foreground">Mínimo {MIN_PASSWORD_LENGTH} caracteres. Comunícala al usuario por un canal seguro; el cambio queda registrado en el historial.</p>
      </div>
    </div>
    <footer class="safe-bottom flex flex-col-reverse gap-3 border-t bg-muted/50 px-5 py-4 sm:flex-row sm:items-center sm:justify-end">
      <button class={buttonVariants({ variant: "outline", size: "lg" })} type="button" data-modal-close>Cancelar</button>
      <button class={buttonVariants({ size: "lg" })} type="submit">Restablecer contraseña</button>
    </footer>
  </form>
</template>
