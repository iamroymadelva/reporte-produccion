---
import AdminActionIcon from "./AdminActionIcon.astro";
interface Props {
  id: string;
  action: string;
  recordName: string;
  title?: string;
  description?: string;
  buttonLabel?: string;
  confirmLabel?: string;
  intent?: string;
}

const {
  id,
  action,
  recordName,
  title = "Eliminar registro",
  description = "Esta acción es irreversible. Si el registro tiene uso histórico, la eliminación será bloqueada y podrás desactivarlo en su lugar.",
  confirmLabel = "Eliminar",
  intent = "delete",
} = Astro.props;
const dialogId = `delete-${id.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
const actionLabel = intent === "remove" ? "Retirar usuario" : "Eliminar";
---

<button class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-xl px-3 text-red-700 transition hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2" type="button" title={actionLabel} aria-label={actionLabel} data-modal-open={dialogId}>
  <AdminActionIcon kind={intent === "remove" ? "remove" : "delete"} />
  <span class="admin-action-text">{actionLabel}</span>
</button>
<dialog id={dialogId} class="m-auto max-h-[calc(100dvh-1rem)] w-[min(calc(100vw-1rem),32rem)] overflow-y-auto rounded-2xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/55 sm:max-h-[calc(100dvh-2rem)]">
  <section class="p-6" aria-labelledby={`${dialogId}-title`}>
    <h2 id={`${dialogId}-title`} class="text-2xl font-bold text-slate-950">{title}</h2>
    <p class="mt-4 text-slate-700">Registro: <strong>{recordName}</strong></p>
    <p class="mt-3 leading-7 text-slate-600">{description}</p>
    <form class="safe-bottom mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end" method="POST" action={action}>
      <input type="hidden" name="id" value={id} />
      <input type="hidden" name="intent" value={intent} />
      <button class="button-secondary min-h-12" type="button" data-modal-close>Cancelar</button>
      <button class="button-danger min-h-12" type="submit">{confirmLabel}</button>
    </form>
  </section>
</dialog>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const opener = target.closest<HTMLElement>("[data-modal-open]");
    if (opener) {
      const dialog = document.getElementById(opener.dataset.modalOpen ?? "");
      if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal();
    }
    const closer = target.closest<HTMLElement>("[data-modal-close]");
    if (closer) closer.closest("dialog")?.close();
    if (target instanceof HTMLDialogElement) target.close();
  });
</script>
