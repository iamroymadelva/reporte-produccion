---
import { Trash2, UserMinus } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";

interface Props {
  id: string;
  action: string;
  recordName: string;
  title?: string;
  description?: string;
  buttonLabel?: string;
  confirmLabel?: string;
  intent?: string;
}

const {
  id,
  action,
  recordName,
  title = "Eliminar registro",
  description = "Esta acción es irreversible. Si el registro tiene uso histórico, la eliminación será bloqueada y podrás desactivarlo en su lugar.",
  confirmLabel = "Eliminar",
  intent = "delete",
} = Astro.props;
const dialogId = `delete-${id.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
const actionLabel = intent === "remove" ? "Retirar usuario" : "Eliminar";
const Icon = intent === "remove" ? UserMinus : Trash2;
---

<button class={buttonVariants({ variant: "ghost", className: "min-w-11 px-3 text-destructive hover:bg-destructive/10 hover:text-destructive" })} type="button" title={actionLabel} aria-label={actionLabel} data-modal-open={dialogId}>
  <Icon className="size-5" aria-hidden="true" />
  <span class="admin-action-text">{actionLabel}</span>
</button>
<template id={dialogId} data-admin-dialog-template data-dialog-title={title} data-dialog-description={description} data-dialog-kind="alert">
  <section class="p-6" aria-labelledby={`${dialogId}-title`}>
    <h2 id={`${dialogId}-title`} class="text-2xl font-bold text-foreground">{title}</h2>
    <p class="mt-4 text-foreground">Registro: <strong>{recordName}</strong></p>
    <p class="mt-3 leading-7 text-muted-foreground">{description}</p>
    <form class="safe-bottom mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end" method="POST" action={action}>
      <input type="hidden" name="id" value={id} />
      <input type="hidden" name="intent" value={intent} />
      <button class={buttonVariants({ variant: "outline", size: "lg" })} type="button" data-modal-close>Cancelar</button>
      <button class={buttonVariants({ variant: "destructive", size: "lg" })} type="submit">{confirmLabel}</button>
    </form>
  </section>
</template>
