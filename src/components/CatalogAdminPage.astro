---
import AdminSearch from "./AdminSearch.astro";
import AdminFlashMessage from "./AdminFlashMessage.astro";
import AdminRecordModal from "./AdminRecordModal.astro";
import AdminReactivateAction from "./AdminReactivateAction.astro";
import AdminStatusToggle from "./AdminStatusToggle.astro";
import DestructiveAction from "./DestructiveAction.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Profile } from "../lib/types";

interface CatalogItem { id: string; code: string; name: string; active: boolean }
interface Props {
  profile: Profile;
  title: string;
  description: string;
  catalog: string;
  items: CatalogItem[];
  error?: string | null;
  ok?: string | null;
}

const { profile, title, description, catalog, items, error, ok } = Astro.props;
const action = `/api/admin/catalogs/${catalog}`;
---

<BaseLayout title={title} description={description} profile={profile}>
  <main class="mx-auto max-w-6xl space-y-6 px-4 py-8 sm:px-6" data-search-scope>
    <header>
      <a class="text-sm font-semibold text-emerald-700" href="/administracion">← Administración</a>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <div><h1 class="text-3xl font-bold">{title}</h1><p class="mt-2 text-slate-600">{description}</p></div>
        <AdminRecordModal id={`create-${catalog}`} title={`Nuevo: ${title}`} action={action} submitLabel="Crear" mode="create">
          <div class="grid gap-4">
            <label><span class="field-label">Código</span><input class="field-control" name="code" required /></label>
            <label><span class="field-label">Nombre</span><input class="field-control" name="name" required /></label>
          </div>
        </AdminRecordModal>
      </div>
    </header>
    <AdminFlashMessage error={error} ok={ok} />

    <label class="block max-w-lg"><span class="field-label">Buscar</span><input class="field-control" type="search" placeholder={`Buscar en ${title.toLocaleLowerCase("es-CO")}`} data-search-input /></label>

    <section class="panel overflow-hidden p-0">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[680px] text-left text-sm">
          <thead class="bg-slate-50 text-slate-600"><tr><th class="p-4">Código</th><th class="p-4">Nombre</th><th class="p-4">Estado</th><th class="p-4 text-right">Acción</th></tr></thead>
          <tbody>
            {items.map((item) => (
              <tr class="border-t align-top" data-search-row data-search-text={`${item.code} ${item.name} ${item.active ? "activo" : "inactivo"}`}>
                <td class="p-4 font-semibold">{item.code}</td><td class="p-4">{item.name}</td>
                <td class="p-4"><AdminStatusToggle id={item.id} action={action} active={item.active}><input type="hidden" name="code" value={item.code} /><input type="hidden" name="name" value={item.name} /></AdminStatusToggle></td>
                <td class="p-4 text-right"><div class="flex flex-wrap items-center justify-end gap-2">
                  <AdminRecordModal id={`edit-${catalog}-${item.id}`} title={`Editar: ${item.name}`} action={action} submitLabel="Guardar" mode="edit" recordId={item.id}>
                    <div class="grid gap-4">
                      <label><span class="field-label">Código</span><input class="field-control" name="code" value={item.code} required /></label>
                      <label><span class="field-label">Nombre</span><input class="field-control" name="name" value={item.name} required /></label>
                      <label class="flex min-h-12 items-center gap-2"><input class="size-5" type="checkbox" name="active" checked={item.active} /><span class="font-semibold">Activo</span></label>
                    </div>
                  </AdminRecordModal>
                  {!item.active && <AdminReactivateAction id={item.id} action={action} />}
                  <DestructiveAction id={item.id} action={action} recordName={`${item.code} · ${item.name}`} />
                </div></td>
              </tr>
            ))}
            {items.length === 0 && <tr><td class="p-8 text-center text-slate-500" colspan="4">No hay valores configurados.</td></tr>}
          </tbody>
        </table>
      </div>
    </section>
    <AdminSearch />
  </main>
</BaseLayout>
