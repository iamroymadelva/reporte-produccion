---
import AdminSearch from "./AdminSearch.astro";
import AdminRecordModal from "./AdminRecordModal.astro";
import AdminReactivateAction from "./AdminReactivateAction.astro";
import AdminStatusToggle from "./AdminStatusToggle.astro";
import DestructiveAction from "./DestructiveAction.astro";
import PageHeader from "./PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { FieldLabel, Label } from "@/components/ui/label";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import type { Profile } from "../lib/types";

interface CatalogItem { id: string; code: string; name: string; active: boolean }
interface Props {
  profile: Profile;
  title: string;
  description: string;
  catalog: string;
  items: CatalogItem[];
  /** Error de carga de datos (los resultados ?ok/?error de las acciones se muestran como toast). */
  error?: string | null;
}

const { profile, title, description, catalog, items, error } = Astro.props;
const action = `/api/admin/catalogs/${catalog}`;
---

<BaseLayout title={title} description={description} profile={profile}>
  <main class="mx-auto max-w-6xl space-y-6 px-4 py-8 sm:px-6" data-search-scope>
    <PageHeader title={title} description={description} back={{ href: "/administracion", label: "Administración" }}>
      <AdminRecordModal slot="actions" id={`create-${catalog}`} title={`Nuevo: ${title}`} action={action} submitLabel="Crear" mode="create">
        <div class="grid gap-4">
          <Label><FieldLabel>Código</FieldLabel><Input name="code" required /></Label>
          <Label><FieldLabel>Nombre</FieldLabel><Input name="name" required /></Label>
        </div>
      </AdminRecordModal>
    </PageHeader>

    {error && <Alert variant="destructive"><AlertDescription>{error}</AlertDescription></Alert>}

    <Label className="block max-w-lg"><FieldLabel>Buscar</FieldLabel><Input type="search" enterKeyHint="search" placeholder={`Buscar en ${title.toLocaleLowerCase("es-CO")}`} data-search-input /></Label>

    <Card className="gap-0 overflow-hidden py-0">
      <Table className="responsive-admin-table min-w-[680px]">
        <TableHeader><TableRow><TableHead>Código</TableHead><TableHead>Nombre</TableHead><TableHead>Estado</TableHead><TableHead className="text-right">Acción</TableHead></TableRow></TableHeader>
        <TableBody>
          {items.map((item) => (
            <TableRow data-search-row data-search-text={`${item.code} ${item.name} ${item.active ? "activo" : "inactivo"}`}>
              <TableCell className="font-semibold" data-label="Código">{item.code}</TableCell>
              <TableCell data-label="Nombre">{item.name}</TableCell>
              <TableCell data-label="Estado"><AdminStatusToggle id={item.id} action={action} active={item.active}><input type="hidden" name="code" value={item.code} /><input type="hidden" name="name" value={item.name} /></AdminStatusToggle></TableCell>
              <TableCell className="text-right" data-label="Acciones"><div class="flex flex-wrap items-center justify-end gap-2">
                <AdminRecordModal id={`edit-${catalog}-${item.id}`} title={`Editar: ${item.name}`} action={action} submitLabel="Guardar" mode="edit" recordId={item.id}>
                  <div class="grid gap-4">
                    <Label><FieldLabel>Código</FieldLabel><Input name="code" value={item.code} required /></Label>
                    <Label><FieldLabel>Nombre</FieldLabel><Input name="name" value={item.name} required /></Label>
                    <Label className="flex min-h-12 items-center gap-2"><input class="size-5 accent-primary" type="checkbox" name="active" checked={item.active} /><span class="font-semibold">Activo</span></Label>
                  </div>
                </AdminRecordModal>
                {!item.active && <AdminReactivateAction id={item.id} action={action} />}
                <DestructiveAction id={item.id} action={action} recordName={`${item.code} · ${item.name}`} />
              </div></TableCell>
            </TableRow>
          ))}
          {items.length === 0 && <TableRow><TableCell className="p-8 text-center text-muted-foreground" colSpan={4}>No hay valores configurados.</TableCell></TableRow>}
        </TableBody>
      </Table>
    </Card>
    <AdminSearch />
  </main>
</BaseLayout>
