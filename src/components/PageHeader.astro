---
import { ArrowLeft } from "lucide-react";
import { cn } from "@/lib/utils";

interface Props {
  title: string;
  description?: string;
  back?: { href: string; label: string };
  /** Clases extra para el H1 (p. ej. `font-mono tabular-nums` para folios). */
  titleClass?: string;
  class?: string;
}

const { title, description, back, titleClass, class: className } = Astro.props;
const hasActions = Astro.slots.has("actions");
const hasMeta = Astro.slots.has("default");
---

<header class={cn("flex flex-wrap items-start justify-between gap-3", className)}>
  <div class="min-w-0">
    {back && (
      <a class="mb-2 inline-flex min-h-11 items-center gap-1.5 rounded-md text-sm text-muted-foreground transition-colors hover:text-foreground" href={back.href}>
        <ArrowLeft className="size-4" aria-hidden="true" />
        {back.label}
      </a>
    )}
    <h1 class={cn("text-xl font-bold tracking-tight lg:text-3xl", titleClass)}>{title}</h1>
    {description && <p class="text-sm text-muted-foreground">{description}</p>}
    {hasMeta && <div class="mt-2"><slot /></div>}
  </div>
  {hasActions && <div class="flex flex-wrap items-center gap-2"><slot name="actions" /></div>}
</header>
