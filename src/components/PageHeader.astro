---
import { ArrowLeft } from "lucide-react";
import { cn } from "@/lib/utils";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  back?: { href: string; label: string };
  /** Clases extra para el H1 (p. ej. `font-mono tabular-nums` para folios). */
  titleClass?: string;
  class?: string;
}

const { eyebrow, title, description, back, titleClass, class: className } = Astro.props;
const hasActions = Astro.slots.has("actions");
const hasMeta = Astro.slots.has("default");
---

<header class={cn("flex flex-wrap items-end justify-between gap-4", className)}>
  <div class="min-w-0">
    {back && (
      <a class="mb-2 inline-flex min-h-11 items-center gap-1.5 rounded-md text-sm font-semibold text-primary underline-offset-4 transition-colors hover:text-primary/80 hover:underline" href={back.href}>
        <ArrowLeft className="size-4" aria-hidden="true" />
        {back.label}
      </a>
    )}
    {eyebrow && <p class="text-xs font-semibold uppercase tracking-wider text-primary">{eyebrow}</p>}
    <h1 class={cn("mt-1 text-2xl font-bold tracking-tight text-foreground sm:text-3xl", titleClass)}>{title}</h1>
    {description && <p class="mt-2 text-muted-foreground">{description}</p>}
    {hasMeta && <div class="mt-2"><slot /></div>}
  </div>
  {hasActions && <div class="flex flex-wrap items-center gap-3"><slot name="actions" /></div>}
</header>
