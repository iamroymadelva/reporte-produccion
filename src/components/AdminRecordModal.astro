---
import { Pencil, X } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";

interface Props {
  id: string;
  title: string;
  action: string;
  submitLabel: "Crear" | "Guardar" | "Crear usuario" | "Guardar cambios";
  mode: "create" | "edit";
  recordId?: string;
  size?: "default" | "large";
  description?: string;
}

const { id, title, action, submitLabel, mode, recordId, size = "default", description } = Astro.props;
const dialogDescription = description ?? (mode === "create"
  ? "Completa los datos del nuevo registro."
  : "Modifica los datos del registro y guarda los cambios.");
---

{mode === "create" ? (
  <button class={buttonVariants({ size: "lg" })} type="button" data-admin-modal-open={id}>Nuevo</button>
) : (
  <button class={buttonVariants({ variant: "ghost", className: "min-w-11 px-3 text-primary hover:text-primary" })} type="button" title="Editar" aria-label="Editar" data-admin-modal-open={id}>
    <Pencil className="size-5" aria-hidden="true" />
    <span class="admin-action-text">Editar</span>
  </button>
)}

{/* Contrato con AdminDialogHost: data-dialog-title y data-dialog-description alimentan el título y la
   descripción accesibles del diálogo. El host usa showCloseButton={false}: el botón cerrar es el de esta plantilla. */}
<template id={id} data-admin-dialog-template data-dialog-title={title} data-dialog-description={dialogDescription} data-dialog-size={size}>
  <form class="grid max-h-[calc(100dvh-1rem)] w-full min-w-0 grid-rows-[auto_minmax(0,1fr)_auto] sm:max-h-[calc(100dvh-2rem)]" method="POST" action={action}>
    {recordId && <input type="hidden" name="id" value={recordId} />}
    <header class="flex items-center justify-between gap-3 border-b px-5 py-4">
      <h2 id={`${id}-title`} class="text-xl font-bold text-foreground">{title}</h2>
      <button class={buttonVariants({ variant: "ghost", size: "icon-touch" })} type="button" title="Cerrar" aria-label="Cerrar" data-admin-modal-close>
        <X className="size-5" aria-hidden="true" />
      </button>
    </header>
    <div class="min-h-0 min-w-0 overflow-y-auto p-5"><slot /></div>
    <footer class="safe-bottom flex flex-col-reverse gap-3 border-t bg-muted/50 px-5 py-4 sm:flex-row sm:items-center sm:justify-end">
      <button class={buttonVariants({ variant: "outline", size: "lg" })} type="button" data-admin-modal-close>Cancelar</button>
      <button class={buttonVariants({ size: "lg" })} type="submit">{submitLabel}</button>
    </footer>
  </form>
</template>
