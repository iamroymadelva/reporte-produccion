---
import { UserPlus, X } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import UserAssignmentsField from "./UserAssignmentsField.astro";
import type { AppRole } from "../lib/types";

interface MachineOption {
  id: string;
  code: string;
  name: string;
}

interface ShiftOption {
  id: string;
  name: string | null;
  start_time: string;
  end_time: string;
}

interface Props {
  userId: string;
  userName: string;
  role: AppRole;
  machines: MachineOption[];
  shifts: ShiftOption[];
}

const { userId, userName, role, machines, shifts } = Astro.props;
const dialogId = `reactivate-user-${userId.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
---

<button
  class={buttonVariants({ variant: "ghost", className: "text-primary hover:text-primary" })}
  type="button"
  title="Reactivar usuario"
  aria-label="Reactivar usuario"
  data-user-reactivate-open={dialogId}
>
  <UserPlus className="pointer-events-none size-5" aria-hidden="true" />
  <span>Reactivar usuario</span>
</button>

{/* Contrato con AdminDialogHost: data-dialog-title y data-dialog-description; el host usa showCloseButton={false}. */}
<template id={dialogId} data-admin-dialog-template data-dialog-title="Reactivar usuario" data-dialog-description="Restaura el acceso del usuario conservando su identidad e historial." data-dialog-size="large">
  <form class="grid max-h-[calc(100dvh-1rem)] w-full min-w-0 grid-rows-[auto_minmax(0,1fr)_auto] sm:max-h-[calc(100dvh-2rem)]" method="POST" action={`/api/admin/users/${userId}`}>
    <input type="hidden" name="intent" value="reactivate" />
    <header class="flex items-center justify-between gap-3 border-b px-5 py-4">
      <h2 id={`${dialogId}-title`} class="text-xl font-bold text-foreground">Reactivar usuario</h2>
      <button class={buttonVariants({ variant: "ghost", size: "icon-touch" })} type="button" title="Cerrar" aria-label="Cerrar" data-user-reactivate-close>
        <X className="size-5" aria-hidden="true" />
      </button>
    </header>
    <div class="min-h-0 overflow-y-auto p-5">
      <p class="text-foreground">Se restaurará el acceso de <strong>{userName}</strong> conservando su identidad e historial.</p>
      {role === "OPERATOR" && (
        <>
          <p class="mt-3 text-sm text-muted-foreground">Las asignaciones anteriores no se restauran automáticamente: selecciona las que tendrá ahora.</p>
          <UserAssignmentsField machines={machines} shifts={shifts} />
        </>
      )}
      {role !== "OPERATOR" && <p class="mt-4 text-sm text-muted-foreground">No se activarán asignaciones de máquinas para este rol.</p>}
    </div>
    <footer class="safe-bottom flex flex-col-reverse gap-3 border-t bg-muted/50 px-5 py-4 sm:flex-row sm:items-center sm:justify-end">
      <button class={buttonVariants({ variant: "outline", size: "lg" })} type="button" data-user-reactivate-close>Cancelar</button>
      <button class={buttonVariants({ size: "lg" })} type="submit">Reactivar usuario</button>
    </footer>
  </form>
</template>
