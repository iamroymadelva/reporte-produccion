    {type === "clients" && <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M5.25 21V6.75A1.5 1.5 0 0 1 6.75 5.25h4.5a1.5 1.5 0 0 1 1.5 1.5V21m0-10.5h4.5a1.5 1.5 0 0 1 1.5 1.5v9M7.5 8.25h3m-3 3h3m-3 3h3m-3 3h3m5.25-3h.008v.008h-.008V14.25Zm0 3h.008v.008h-.008V17.25Z" />}
