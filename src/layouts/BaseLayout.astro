---
import "../styles/global.css";
import ConnectionStatus from "../components/ConnectionStatus.astro";
import { roleLabels, type Profile } from "../lib/types";

interface Props {
  title: string;
  description: string;
  profile?: Profile | null;
}

const { title, description, profile = null } = Astro.props;
const pathname = Astro.url.pathname;
const isCurrent = (href: string) => href === "/dashboard"
  ? pathname === href
  : pathname === href || pathname.startsWith(`${href}/`);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#065f46" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Producción" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon-180.png" />
    <title>{title}</title>
  </head>
  <body>
    {profile && (
      <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto hidden max-w-7xl items-center justify-between gap-3 px-6 py-3 sm:flex">
          <a href="/dashboard" class="font-bold text-emerald-800">Reporte de Producción</a>
          <nav class="flex flex-wrap items-center gap-2 text-sm" aria-label="Navegación principal">
            <a class:list={["inline-flex min-h-11 items-center rounded-lg px-3 py-2 font-medium hover:bg-slate-100", isCurrent("/dashboard") && "bg-slate-100 text-emerald-800"]} href="/dashboard" aria-current={isCurrent("/dashboard") ? "page" : undefined}>Dashboard</a>
            <a class:list={["inline-flex min-h-11 items-center rounded-lg px-3 py-2 font-medium hover:bg-slate-100", isCurrent("/reportes") && "bg-slate-100 text-emerald-800"]} href="/reportes" aria-current={isCurrent("/reportes") ? "page" : undefined}>Reportes</a>
            {profile.role === "ADMINISTRATOR" && (
              <a class:list={["inline-flex min-h-11 items-center rounded-lg px-3 py-2 font-medium hover:bg-slate-100", isCurrent("/administracion") && "bg-slate-100 text-emerald-800"]} href="/administracion" aria-current={isCurrent("/administracion") ? "page" : undefined}>Administración</a>
            )}
            <span class="text-slate-500">{profile.full_name} · {roleLabels[profile.role]}</span>
            <form method="POST" action="/api/auth/logout">
              <button class="inline-flex min-h-11 items-center rounded-lg px-3 py-2 font-semibold text-red-700 hover:bg-red-50" type="submit">Salir</button>
            </form>
          </nav>
        </div>
        <div class="mx-auto max-w-7xl px-4 py-3 sm:hidden">
          <div class="flex min-h-11 items-center justify-between gap-3">
            <a href="/dashboard" class="min-w-0 truncate font-bold text-emerald-800">Reporte de Producción</a>
            <button class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 font-semibold text-slate-800" type="button" aria-expanded="false" aria-controls="mobile-navigation" data-mobile-menu-toggle>
              Menú
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>
          </div>
          <nav id="mobile-navigation" class="mt-3 hidden border-t border-slate-200 pt-3" aria-label="Navegación principal" data-mobile-menu>
            <div class="mb-3 rounded-xl bg-slate-50 p-3 text-sm text-slate-600">
              <span class="block font-semibold text-slate-900">{profile.full_name}</span>
              <span>{roleLabels[profile.role]}</span>
            </div>
            <div class="grid gap-1">
              <a class:list={["flex min-h-11 items-center rounded-lg px-3 py-2 font-medium", isCurrent("/dashboard") ? "bg-emerald-50 text-emerald-800" : "hover:bg-slate-100"]} href="/dashboard" aria-current={isCurrent("/dashboard") ? "page" : undefined}>Dashboard</a>
              <a class:list={["flex min-h-11 items-center rounded-lg px-3 py-2 font-medium", isCurrent("/reportes") ? "bg-emerald-50 text-emerald-800" : "hover:bg-slate-100"]} href="/reportes" aria-current={isCurrent("/reportes") ? "page" : undefined}>Reportes</a>
              {profile.role === "ADMINISTRATOR" && <a class:list={["flex min-h-11 items-center rounded-lg px-3 py-2 font-medium", isCurrent("/administracion") ? "bg-emerald-50 text-emerald-800" : "hover:bg-slate-100"]} href="/administracion" aria-current={isCurrent("/administracion") ? "page" : undefined}>Administración</a>}
              <form method="POST" action="/api/auth/logout"><button class="flex min-h-11 w-full items-center rounded-lg px-3 py-2 font-semibold text-red-700 hover:bg-red-50" type="submit">Salir</button></form>
            </div>
          </nav>
        </div>
      </header>
    )}
    <ConnectionStatus />
    <slot />
  </body>
</html>

<script>
  import {
    canSendMutation,
    MUTATION_REQUIRES_CONNECTION,
    showConnectivityNotice,
  } from "../lib/connectivity";

  const toggle = document.querySelector<HTMLElement>("[data-mobile-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    menu?.classList.toggle("hidden", expanded);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || toggle?.getAttribute("aria-expanded") !== "true") return;
    toggle.setAttribute("aria-expanded", "false");
    menu?.classList.add("hidden");
    toggle.focus();
  });

  const guardedForms = new WeakSet<HTMLFormElement>();
  const checkingForms = new WeakSet<HTMLFormElement>();

  document.addEventListener("submit", (event) => {
    const submitEvent = event as SubmitEvent;
    const form = submitEvent.target;
    if (!(form instanceof HTMLFormElement) || form.method.toUpperCase() !== "POST") return;
    if (guardedForms.has(form)) {
      guardedForms.delete(form);
      return;
    }

    submitEvent.preventDefault();
    submitEvent.stopImmediatePropagation();
    if (checkingForms.has(form)) return;
    checkingForms.add(form);

    const submitter = submitEvent.submitter;
    if (submitter instanceof HTMLElement) submitter.setAttribute("aria-busy", "true");

    void canSendMutation().then((allowed) => {
      checkingForms.delete(form);
      if (submitter instanceof HTMLElement) submitter.removeAttribute("aria-busy");
      if (!allowed) {
        showConnectivityNotice(MUTATION_REQUIRES_CONNECTION);
        return;
      }

      guardedForms.add(form);
      if (submitter instanceof HTMLButtonElement || submitter instanceof HTMLInputElement) form.requestSubmit(submitter);
      else form.requestSubmit();
    });
  }, true);
</script>
