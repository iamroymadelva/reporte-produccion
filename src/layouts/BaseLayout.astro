---
import "../styles/global.css";
import ConnectionStatus from "../components/ConnectionStatus.astro";
import AppShell from "../components/AppShell";
import AdminDialogHost from "../components/AdminDialogHost";
import type { Profile } from "../lib/types";

interface Props {
  title: string;
  description: string;
  profile?: Profile | null;
}

const { title, description, profile = null } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#172554" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Producción" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon-180.png" />
    <title>{title}</title>
  </head>
  <body class={profile ? "has-app-shell" : undefined}>
    {profile && <>
      <a class="skip-link" href="#main-content">Saltar al contenido</a>
      <AppShell profile={profile} pathname={pathname} client:load />
    </>}
    <div id="main-content" class={profile ? "app-content" : undefined} tabindex="-1">
      <ConnectionStatus />
      <slot />
    </div>
    {profile?.role === "ADMINISTRATOR" && <AdminDialogHost client:load />}
  </body>
</html>

<script>
  import {
    canSendMutation,
    MUTATION_REQUIRES_CONNECTION,
    showConnectivityNotice,
  } from "../lib/connectivity";

  const guardedForms = new WeakSet<HTMLFormElement>();
  const checkingForms = new WeakSet<HTMLFormElement>();

  document.addEventListener("submit", (event) => {
    const submitEvent = event as SubmitEvent;
    const form = submitEvent.target;
    if (!(form instanceof HTMLFormElement) || form.method.toUpperCase() !== "POST") return;
    if (guardedForms.has(form)) {
      guardedForms.delete(form);
      return;
    }

    submitEvent.preventDefault();
    submitEvent.stopImmediatePropagation();
    if (checkingForms.has(form)) return;
    checkingForms.add(form);

    const submitter = submitEvent.submitter;
    const submitButton = submitter instanceof HTMLButtonElement || submitter instanceof HTMLInputElement
      ? submitter
      : null;
    const wasDisabled = submitButton?.disabled ?? false;
    const originalButtonContent = submitButton instanceof HTMLButtonElement
      ? Array.from(submitButton.childNodes)
      : null;
    const originalInputValue = submitButton instanceof HTMLInputElement
      ? submitButton.value
      : null;

    if (submitButton) {
      submitButton.setAttribute("aria-busy", "true");
      submitButton.disabled = true;
      if (submitButton instanceof HTMLButtonElement) submitButton.replaceChildren("Comprobando conexión…");
      else submitButton.value = "Comprobando conexión…";
    }

    const restoreSubmitButton = () => {
      if (!submitButton) return;
      submitButton.removeAttribute("aria-busy");
      submitButton.disabled = wasDisabled;
      if (submitButton instanceof HTMLButtonElement && originalButtonContent) submitButton.replaceChildren(...originalButtonContent);
      else if (submitButton instanceof HTMLInputElement && originalInputValue !== null) submitButton.value = originalInputValue;
    };

    void canSendMutation().then((allowed) => {
      checkingForms.delete(form);
      restoreSubmitButton();
      if (!allowed) {
        showConnectivityNotice(MUTATION_REQUIRES_CONNECTION);
        return;
      }

      guardedForms.add(form);
      const submitNatively = () => {
        guardedForms.delete(form);
        HTMLFormElement.prototype.submit.call(form);
      };

      try {
        if (submitter instanceof HTMLButtonElement || submitter instanceof HTMLInputElement) form.requestSubmit(submitter);
        else form.requestSubmit();
      } catch {
        submitNatively();
        return;
      }

      if (guardedForms.has(form)) submitNatively();
    });
  }, true);
</script>
