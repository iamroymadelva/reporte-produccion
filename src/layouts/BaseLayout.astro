---
import "../styles/global.css";
import ConnectionStatus from "../components/ConnectionStatus.astro";
import { roleLabels, type Profile } from "../lib/types";

interface Props {
  title: string;
  description: string;
  profile?: Profile | null;
}

const { title, description, profile = null } = Astro.props;
const pathname = Astro.url.pathname;
const isCurrent = (href: string) => href === "/dashboard"
  ? pathname === href
  : pathname === href || pathname.startsWith(`${href}/`);
const navItems = [
  { href: "/dashboard", label: "Dashboard" },
  { href: "/reportes", label: "Reportes" },
  ...(profile?.role === "ADMINISTRATOR" ? [{ href: "/administracion", label: "Administración" }] : []),
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#172554" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Producción" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon-180.png" />
    <title>{title}</title>
  </head>
  <body>
    {profile && (
      <header class="sticky top-0 z-30 bg-brand-950 text-white shadow-md">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
          <a href="/dashboard" class="flex min-h-14 min-w-0 items-center gap-3 font-semibold tracking-tight">
            <span class="grid size-8 shrink-0 place-items-center rounded-md bg-accent-500 text-slate-950" aria-hidden="true">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V10l5 3V10l5 3V5h4v16" /></svg>
            </span>
            <span class="truncate">Reporte de Producción</span>
          </a>
          <nav class="hidden items-stretch gap-1 self-stretch text-sm sm:flex" aria-label="Navegación principal">
            {navItems.map((item) => (
              <a class:list={["relative inline-flex items-center px-3 font-medium transition-colors duration-150", isCurrent(item.href) ? "text-white after:absolute after:inset-x-3 after:bottom-0 after:h-[3px] after:rounded-t after:bg-accent-400" : "text-brand-200 hover:text-white"]} href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
            ))}
          </nav>
          <div class="hidden items-center gap-3 text-sm sm:flex">
            <span class="hidden text-right leading-tight lg:block">
              <span class="block font-semibold text-white">{profile.full_name}</span>
              <span class="text-xs text-brand-200">{roleLabels[profile.role]}</span>
            </span>
            <form method="POST" action="/api/auth/logout">
              <button class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-white/20 px-3 py-2 font-semibold text-white transition-colors duration-150 hover:bg-white/10" type="submit">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3" /></svg>
                Salir
              </button>
            </form>
          </div>
          <button class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg border border-white/20 px-3 font-semibold text-white transition-colors duration-150 hover:bg-white/10 sm:hidden" type="button" aria-expanded="false" aria-controls="mobile-navigation" data-mobile-menu-toggle>
            Menú
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
        </div>
        <nav id="mobile-navigation" class="hidden border-t border-white/10 px-4 pb-4 pt-3 sm:hidden" aria-label="Navegación principal" data-mobile-menu>
          <div class="mb-3 rounded-lg bg-white/5 p-3 text-sm">
            <span class="block font-semibold text-white">{profile.full_name}</span>
            <span class="text-brand-200">{roleLabels[profile.role]}</span>
          </div>
          <div class="grid gap-1">
            {navItems.map((item) => (
              <a class:list={["flex min-h-12 items-center rounded-lg border-l-[3px] px-3 py-2 font-medium transition-colors duration-150", isCurrent(item.href) ? "border-accent-400 bg-white/10 text-white" : "border-transparent text-brand-100 hover:bg-white/5"]} href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
            ))}
            <form method="POST" action="/api/auth/logout"><button class="flex min-h-12 w-full items-center rounded-lg px-3 py-2 font-semibold text-red-300 transition-colors duration-150 hover:bg-white/5" type="submit">Salir</button></form>
          </div>
        </nav>
      </header>
    )}
    <ConnectionStatus />
    <slot />
  </body>
</html>

<script>
  import {
    canSendMutation,
    MUTATION_REQUIRES_CONNECTION,
    showConnectivityNotice,
  } from "../lib/connectivity";

  const toggle = document.querySelector<HTMLElement>("[data-mobile-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    menu?.classList.toggle("hidden", expanded);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || toggle?.getAttribute("aria-expanded") !== "true") return;
    toggle.setAttribute("aria-expanded", "false");
    menu?.classList.add("hidden");
    toggle.focus();
  });

  const guardedForms = new WeakSet<HTMLFormElement>();
  const checkingForms = new WeakSet<HTMLFormElement>();

  document.addEventListener("submit", (event) => {
    const submitEvent = event as SubmitEvent;
    const form = submitEvent.target;
    if (!(form instanceof HTMLFormElement) || form.method.toUpperCase() !== "POST") return;
    if (guardedForms.has(form)) {
      guardedForms.delete(form);
      return;
    }

    submitEvent.preventDefault();
    submitEvent.stopImmediatePropagation();
    if (checkingForms.has(form)) return;
    checkingForms.add(form);

    const submitter = submitEvent.submitter;
    const submitButton = submitter instanceof HTMLButtonElement || submitter instanceof HTMLInputElement
      ? submitter
      : null;
    const wasDisabled = submitButton?.disabled ?? false;
    const originalButtonContent = submitButton instanceof HTMLButtonElement
      ? Array.from(submitButton.childNodes)
      : null;
    const originalInputValue = submitButton instanceof HTMLInputElement
      ? submitButton.value
      : null;

    if (submitButton) {
      submitButton.setAttribute("aria-busy", "true");
      submitButton.disabled = true;
      if (submitButton instanceof HTMLButtonElement) submitButton.replaceChildren("Comprobando conexión…");
      else submitButton.value = "Comprobando conexión…";
    }

    const restoreSubmitButton = () => {
      if (!submitButton) return;
      submitButton.removeAttribute("aria-busy");
      submitButton.disabled = wasDisabled;
      if (submitButton instanceof HTMLButtonElement && originalButtonContent) submitButton.replaceChildren(...originalButtonContent);
      else if (submitButton instanceof HTMLInputElement && originalInputValue !== null) submitButton.value = originalInputValue;
    };

    void canSendMutation().then((allowed) => {
      checkingForms.delete(form);
      restoreSubmitButton();
      if (!allowed) {
        showConnectivityNotice(MUTATION_REQUIRES_CONNECTION);
        return;
      }

      guardedForms.add(form);
      const submitNatively = () => {
        guardedForms.delete(form);
        HTMLFormElement.prototype.submit.call(form);
      };

      try {
        if (submitter instanceof HTMLButtonElement || submitter instanceof HTMLInputElement) form.requestSubmit(submitter);
        else form.requestSubmit();
      } catch {
        submitNatively();
        return;
      }

      if (guardedForms.has(form)) submitNatively();
    });
  }, true);
</script>
